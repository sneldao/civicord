# Copy this file to .env and fill in real values. Never commit .env.
# .env is not auto-loaded by Python or by the shell; source it explicitly only
# in a trusted local shell when a runbook requires it.
PARALLEL_AI_API_KEY=your-parallel-ai-api-key-here
ALCHEMY_KEY=your-alchemy-api-key-here

# X Layer / TapeOut DeWEB mirror (local publication/update operations only).
# Never commit real values. TAPEOUT_PRIVATE_KEY is sensitive key material; prefer
# importing it into a local Foundry keystore before signing.
TAPEOUT_PRIVATE_KEY=your-tapeout-owner-private-key-here
TAPEOUT_ADDRESS=0x0000000000000000000000000000000000000000
TAPEOUT_CHAIN_ID=196
TAPEOUT_RPC_URL=https://rpc.xlayer.tech
TAPEOUT_RPC_FALLBACK_URL=https://xlayer.drpc.org
TAPEOUT_CONTAINER=0x0000000000000000000000000000000000000000
TAPEOUT_PROCESSOR=0x0000000000000000000000000000000000000000
TAPEOUT_CIRCUIT_TOKEN_ID=0
