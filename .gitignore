# Environment / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Data (scrapes, archives, snapshots) — EXCEPT the committed frontend build
# snapshot (generated by frontend/scripts/build-data.mjs from pipeline CSVs)
data/
!frontend/src/data/
# Map layer: normally regenerated by build-map.mjs from AK v5 GeoJSON +
# pipeline CSVs. CSVs/GeoJSON are gitignored, so the committed snapshot here
# (same policy as candidates.json) is what CI + fresh clones build against;
# the monthly Refresh workflow PR replaces it with fresh map outputs.
# OG deeds: 650 SVGs generated by build-og.mjs (1 template × 650) — no runtime.
frontend/public/og/
# Command palette index: generated by build-search.mjs, lazy-fetched on first ⌘K.
frontend/public/search-index.json
*.warc
*.warc.gz
*.parquet
*.duckdb
*.sqlite3

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
# Deploy state (addresses only, no keys) — deployer key lives OUTSIDE the repo
# at ~/.config/civicord/sepolia.key
scripts/publish/.deployed.json
scripts/publish/.abi-cache/

# Cloudflare wrangler state
.wrangler/

# Astro build cache
.astro/
# Correction requests queued by the local dev/preview server. Not the audit.
frontend/.data/

# Root npm (graph tooling dev deps — commit package.json, ignore lock)
node_modules/
package-lock.json

# Subgraph build output (regenerate with `npx graph build`)
subgraph/build/

# Astro dist is never committed (regenerate with `npm run build` in frontend/)
frontend/dist/
# Note: subgraph/generated/ is intentionally tracked so `npx graph build`
# works without codegen in a fresh clone.
