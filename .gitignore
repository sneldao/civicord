# Environment / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Data (scrapes, archives, snapshots) — EXCEPT the committed frontend build
# snapshot (generated by frontend/scripts/build-data.mjs from pipeline CSVs)
data/
!frontend/src/data/
# Map layer: generated at build time by build-map.mjs from AK v5 GeoJSON + pipeline CSVs.
# Do NOT commit — regenerate with `npm run dev` or `npm run build`.
# candidates.json IS committed (small, maintained snapshot).
frontend/src/data/constituencies.json
frontend/src/data/hexes.json
frontend/src/data/constituency-index.json
*.warc
*.warc.gz
*.parquet
*.duckdb
*.sqlite3

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
# Deploy state (addresses only, no keys) — deployer key lives OUTSIDE the repo
# at ~/.config/civicord/sepolia.key
scripts/publish/.deployed.json
scripts/publish/.abi-cache/

# Cloudflare wrangler state
.wrangler/

# Astro build cache
.astro/

# Root npm (graph tooling dev deps — commit package.json, ignore lock)
node_modules/
package-lock.json

# Subgraph build output (regenerate with `npx graph build`)
subgraph/build/
# Note: subgraph/generated/ is intentionally tracked so `npx graph build`
# works without codegen in a fresh clone.
