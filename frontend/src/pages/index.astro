---
import { getCollection } from "astro:content";
import { ClientRouter } from "astro:transitions";
import { cohortStats } from "../lib/cohorts";
import "../styles/global.css";

// Validated at build time by src/content.config.ts — malformed pipeline
// output fails the build instead of shipping broken pages.
const all = await getCollection("candidates");
const candidates = all.map((e) => e.data).sort((a, b) => a.name.localeCompare(b.name));
const websites = candidates.flatMap((c) => c.websites);
const audited = websites.filter((w) => w.audit);
const live = audited.filter((w) => w.audit?.statusClass === "live");
const dead = audited.filter((w) => w.audit?.statusClass === "dns_error");
const redirected = audited.filter((w) => w.audit?.redirected);
const onchain = candidates.filter((c) => c.onchain);
const pct = (n: number, d: number) => (d ? Math.round((n / d) * 100) : 0);

// Cohort layer: party survival leaderboard (top 8 by site count).
const stats = await cohortStats();
const board = stats.parties.slice(0, 8);
const maxBoard = Math.max(...board.map((r) => r.sites), 1);

// Deep-linkable cohort presets (?party=…&status=…). Serialized once so the
// client filter can boot from the URL — zero new pages, journalist-friendly.
const VALID_STATUSES = new Set([
  "live", "http_error", "dns_error", "connection_error",
  "timeout", "ssl_error", "other_error", "not_audited",
]);
const validParties = new Set(
  candidates.flatMap((c) => c.websites.flatMap((w) => w.parties)).map((p) => p.toLowerCase())
);
const cohortBoot = { statuses: [...VALID_STATUSES], parties: [...validParties] };

const statusLabels: Record<string, string> = {
  live: "Live",
  http_error: "HTTP error",
  dns_error: "Domain gone",
  connection_error: "Conn. failed",
  timeout: "Timed out",
  ssl_error: "SSL error",
  other_error: "Error",
  not_audited: "Not audited",
};

// Status groups for the clickable legend: dot class → [label, statusClasses].
const legendGroups: Array<[string, string, string[]]> = [
  ["g-live", "Live", ["live"]],
  ["g-gone", "Gone", ["dns_error", "connection_error"]],
  ["g-error", "Errors", ["http_error", "timeout", "ssl_error", "other_error"]],
  ["g-unknown", "Not audited", ["not_audited"]],
];
const legendCount = (classes: string[]) =>
  websites.filter((w) => classes.includes(w.audit?.statusClass ?? "not_audited")).length;

// Parties sorted by website count (most first) for the filter dropdown.
const partyCounts = new Map<string, number>();
for (const w of websites) for (const p of w.parties) partyCounts.set(p, (partyCounts.get(p) ?? 0) + 1);
const parties = [...partyCounts.entries()].sort((a, b) => b[1] - a[1]).map(([p]) => p);

// Alphabetical group headers (by surname-ish: last word of the display name).
const surnameOf = (name: string) => name.trim().split(/\s+/).pop()!.toUpperCase();
const groupLetterOf = (name: string) => {
  const ch = surnameOf(name).replace(/^[^A-Z]+/, "").charAt(0);
  return ch >= "A" && ch <= "Z" ? ch : "#";
};
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="When the election ended, candidate websites began to disappear. Civicord gives each UK parliamentary candidate a permanent, publicly verifiable record — who they were, what they published, and whether it's still there."
    />
    <meta property="og:title" content="Civicord — the public record candidates can't delete" />
    <meta
      property="og:description"
      content="A permanent, verifiable record of UK parliamentary candidate websites. What they published, and what happened to it."
    />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Civicord — a public record of UK candidate websites</title>
    <ClientRouter />
  </head>
  <body class="reveal-root">
    <div class="progress" aria-hidden="true"><b id="progress-bar"></b></div>
    <header class="masthead">
      <h1 class="wordmark">Civicord<span class="dot">.</span></h1>
      <p class="lede">
        When the election ended, candidate websites began to disappear. Civicord
        gives every UK parliamentary candidate a permanent, publicly verifiable
        record — who they were, what they published, and whether it's still there.
      </p>
      <p class="tagline">
        Built on Campaign Lab's April 2025 scrape of 2,375 candidates, keyed on
        Democracy Club person IDs, recorded as names on the Ethereum Name Service.
      </p>
    </header>

    <section class="stats" aria-label="Audit summary">
      <div class="stat"><b>{candidates.length.toLocaleString("en-GB")}</b><span>Candidates</span></div>
      <div class="stat"><b>{websites.length.toLocaleString("en-GB")}</b><span>Websites</span></div>
      <div class="stat"><b>{audited.length ? pct(live.length, audited.length) : "—"}%</b><span>Still live</span></div>
      <div class="stat"><b>{dead.length.toLocaleString("en-GB")}</b><span>Domains gone</span></div>
      <div class="stat"><b>{redirected.length.toLocaleString("en-GB")}</b><span>Redirected</span></div>
    </section>

    <section class="how" aria-label="How Civicord works">
      <h2>How it works</h2>
      <ol>
        <li>
          <b>Collect.</b> Campaign Lab scraped every candidate's campaign website in
          April 2025. We've re-checked them all: some are live, some have vanished,
          some now sell insurance.
        </li>
        <li>
          <b>Record.</b> Each candidate gets a permanent public name —
          <code>p1234.civicord.eth</code> — holding their website, status, and
          archived evidence. Once written, records can't be quietly edited or deleted.
        </li>
        <li>
          <b>Verify.</b> You don't need an account, a wallet, or our permission.
          Every claim on this site links to the public record behind it — check it
          yourself, any time, forever.
        </li>
      </ol>
    </section>

    <section class="cohorts" aria-label="Survival by party">
      <h2>Which parties' sites survived?</h2>
      <p class="muted">Share of each party's campaign sites still live — click a row to see its candidates.</p>
      <ol class="board">
        {board.map((r) => (
          <li>
            <a href={`/?party=${encodeURIComponent(r.party.toLowerCase())}`} data-party-link={r.party.toLowerCase()}>
              <span class="board-party">{r.party}</span>
              <span class="board-bar" aria-hidden="true">
                <b style={`width:${Math.round((r.sites / maxBoard) * 100)}%`} class={r.livePct >= 60 ? "ok" : r.livePct >= 40 ? "mid" : "low"}></b>
              </span>
              <span class="board-num"><b>{r.livePct}%</b> live · {r.sites.toLocaleString("en-GB")} sites</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <p class="method">
      Liveness audited 2026-09-07, ~17 months after the scrape — 36% of sites are already
      gone or broken. “Live” means responding <em>and</em> still mentioning the candidate;
      ↳ marks URLs that now redirect elsewhere.
      <a href="/methodology">Methodology ↗</a>
    </p>

    {onchain.length > 0 && (
      <p class="ens-note">
        <b>{onchain.length.toLocaleString("en-GB")} of {candidates.length.toLocaleString("en-GB")}</b>
        candidates already have a permanent public name. Look for
        <span class="onchain-chip">On-chain ✓</span> next to their name.
      </p>
    )}

    <div class="filterbar">
      <input id="q" type="search" placeholder="Filter by candidate, party, website…" autocomplete="off" />
      <label class="visually-hidden" for="status">Filter by status</label>
      <select id="status">
        <option value="all">All statuses</option>
        {Object.entries(statusLabels).map(([value, label]) => <option value={value}>{label}</option>)}
      </select>
      <label class="visually-hidden" for="party">Filter by party</label>
      <select id="party">
        <option value="all">All parties</option>
        {parties.map((p) => <option value={p.toLowerCase()}>{p}</option>)}
      </select>
      <span id="count" class="count" role="status" aria-live="polite"></span>
    </div>

    <div class="legend" role="group" aria-label="Filter by status group">
      {legendGroups.map(([dot, label, classes]) => (
        <button type="button" class="legend-item" data-classes={classes.join(",")} aria-pressed="false">
          <span class={`dot ${dot}`} aria-hidden="true"></span>
          {label} <b>{legendCount(classes).toLocaleString("en-GB")}</b>
        </button>
      ))}
      <span class="legend-hint">click to filter</span>
    </div>

    <table>
      <thead>
        <tr><th>Candidate</th><th>Party</th><th>Election</th><th>Website</th><th>Status</th></tr>
      </thead>
      <tbody>
        {(() => {
          let lastLetter = "";
          return candidates.flatMap((c) =>
            c.websites.flatMap((w, wi) => {
              const letter = wi === 0 ? groupLetterOf(c.name) : "";
              const showHeader = letter !== "" && letter !== lastLetter;
              if (letter !== "") lastLetter = letter;
              const st = w.audit?.statusClass ?? "not_audited";
              return (
                <>
                  {showHeader && (
                    <tr class="group" data-group={letter} aria-hidden="true">
                      <td colspan={5}>{letter}</td>
                    </tr>
                  )}
                  <tr
                    class={`row-st-${st}`}
                    style={`--row-i:${(c.websites.length + wi) % 14}`}
                    data-status={st}
                    data-party={w.parties.map((p) => p.toLowerCase()).join(" ")}
                    data-haystack={`${c.name} ${w.parties.join(" ")} ${w.elections[0] ?? ""} ${w.url}`.toLowerCase()}
                  >
                    <td class="who">
                      <a class="who-name" href={`/candidates/${c.id}`}>{c.name}</a>
                      {c.onchain && <span class="onchain-chip" title={`${c.onchain.ens} — permanent public record`}>On-chain ✓</span>}
                    </td>
                    <td class="muted">{w.parties.join(", ")}</td>
                    <td class="muted">{w.elections[0]}</td>
                    <td class="url">
                      <a class="url" href={w.url} rel="noopener noreferrer" title={w.url}>
                        {w.url.replace(/^https?:\/\//, "").replace(/\/$/, "")}
                      </a>
                    </td>
                    <td>
                      <span class={`badge ${st}`}>{statusLabels[st]}</span>
                      {w.audit?.redirected && <span class="redir" title={w.audit.finalUrl ?? ""}> ↳</span>}
                    </td>
                  </tr>
                </>
              );
            })
          );
        })()}
      </tbody>
    </table>

    <p id="noresults" class="noresults" hidden>
      No candidates match those filters.{" "}
      <button type="button" id="clear">Clear filters</button>
    </p>

    <footer>
      <p>
        Data: Campaign Lab candidate-website scrape (April 2025) · Democracy Club person
        IDs · Liveness audit 2026-09-07 · Wayback history (in progress). Code AGPL-3.0 ·
        <a href="https://github.com/sneldao/civicord">github.com/sneldao/civicord</a>
      </p>
    </footer>

    <script define:vars={{ statuses: cohortBoot.statuses, parties: cohortBoot.parties }}>
      // Serialized allow-lists for deep-link boot (see cohortBoot in frontmatter).
      window.__COHORT_STATUSES = statuses;
      window.__COHORT_PARTIES = parties;
      // astro:page-load fires on first load and after every <ClientRouter />
      // view-transition swap — hoisted module scripts otherwise run only once,
      // which would leave the filter/progress/count-up dead after returning
      // to this page via a view transition. The DOM is swapped fresh each
      // time, so re-running the setup is correct (no stale listeners).
      document.addEventListener("astro:page-load", () => {
        // Tiny subsequence fuzzy matcher (no dependency): every query char must
        // appear in order; exact-substring hits score a bonus and short-circuit.
        // "farrage" still finds "Farage".
        const fuzzyMatch = (hay: string, needle: string): boolean => {
          if (hay.includes(needle)) return true;
          if (needle.length > 40) return false;
          let j = 0;
          for (let i = 0; i < hay.length && j < needle.length; i++) {
            if (hay[i] === needle[j]) j++;
          }
          return j === needle.length;
        };
        const q = document.getElementById("q") as HTMLInputElement;
        const status = document.getElementById("status") as HTMLSelectElement;
        const party = document.getElementById("party") as HTMLSelectElement | null;
        const count = document.getElementById("count")!;
        const noresults = document.getElementById("noresults")!;
        const clear = document.getElementById("clear")!;
        const legend = [...document.querySelectorAll<HTMLButtonElement>(".legend-item")];
        let legendClasses: string[] | null = null; // null = no legend filter
        const rows = [...document.querySelectorAll<HTMLTableRowElement>("tbody tr:not(.group)")];
        const apply = () => {
          const needle = q.value.trim().toLowerCase();
          const want = status.value;
          const wantParty = party?.value ?? "all";
          const isDefault = !needle && want === "all" && wantParty === "all" && !legendClasses;
          let shown = 0;
          let shownLive = 0;
          for (const tr of rows) {
            const show =
              (wantParty === "all" || (tr.dataset.party ?? "").split(" ").includes(wantParty)) &&
              (!needle || fuzzyMatch(tr.dataset.haystack!, needle)) &&
              (want === "all" || tr.dataset.status === want) &&
              (!legendClasses || legendClasses.includes(tr.dataset.status!));
            tr.hidden = !show;
            if (show) {
              shown++;
              if (tr.dataset.status === "live") shownLive++;
            }
          }
          // Group headers follow their section: walking backwards, a header is
          // visible iff at least one row below it (before the next header) is.
          let visibleBelow = false;
          const all = [...document.querySelectorAll<HTMLTableRowElement>("tbody tr")];
          for (let i = all.length - 1; i >= 0; i--) {
            const tr = all[i];
            if (tr.classList.contains("group")) {
              tr.hidden = !visibleBelow;
              visibleBelow = false;
            } else if (!tr.hidden) {
              visibleBelow = true;
            }
          }
          if (isDefault) {
            count.textContent = `${shown.toLocaleString("en-GB")} entries`;
          } else if (shown === 0) {
            count.textContent = `no matches`;
          } else {
            const pctLive = Math.round((shownLive / shown) * 100);
            count.textContent = `${shown.toLocaleString("en-GB")} shown · ${pctLive}% live`;
          }
          noresults.hidden = shown !== 0;
        };
        q.addEventListener("input", () => { syncUrl(); apply(); });
        status.addEventListener("change", () => { syncUrl(); apply(); });
        party?.addEventListener("change", () => { syncUrl(); apply(); });
        legend.forEach((btn) =>
          btn.addEventListener("click", () => {
            const classes = btn.dataset.classes!.split(",");
            const active = btn.getAttribute("aria-pressed") === "true";
            legend.forEach((b) => b.setAttribute("aria-pressed", "false"));
            if (active) {
              legendClasses = null;
            } else {
              btn.setAttribute("aria-pressed", "true");
              legendClasses = classes;
              status.value = "all";
            }
            syncUrl();
            apply();
          })
        );
        clear.addEventListener("click", () => {
          q.value = "";
          status.value = "all";
          if (party) party.value = "all";
          legendClasses = null;
          legend.forEach((b) => b.setAttribute("aria-pressed", "false"));
          syncUrl();
          apply();
          q.focus();
        });
        // Boot from deep-link cohort params (?party=…&status=…&q=…). Unknown
        // values are ignored; the board links + shared URLs just work.
        // syncUrl keeps the address bar in sync so every filter state is
        // itself a shareable cohort link — no new pages needed.
        const params = new URLSearchParams(location.search);
        const bootStatuses = (window as any).__COHORT_STATUSES as string[];
        const bootParties = (window as any).__COHORT_PARTIES as string[];
        const qp = (params.get("party") ?? "").toLowerCase();
        const qs = params.get("status") ?? "";
        const qq = params.get("q") ?? "";
        if (party && qp && bootParties.includes(qp)) party.value = qp;
        if (qs && bootStatuses.includes(qs)) status.value = qs;
        if (qq) q.value = qq.slice(0, 120);
        const syncUrl = () => {
          const out = new URLSearchParams();
          if (q.value.trim()) out.set("q", q.value.trim().slice(0, 120));
          if (status.value !== "all") out.set("status", status.value);
          if ((party?.value ?? "all") !== "all") out.set("party", party!.value);
          const next = out.toString();
          history.replaceState(null, "", next ? `?${next}` : location.pathname);
        };
        apply();

        // Scroll progress line
        const bar = document.getElementById("progress-bar")!;
        const onScroll = () => {
          const max = document.documentElement.scrollHeight - innerHeight;
          bar.style.width = `${max > 0 ? Math.min(100, (scrollY / max) * 100) : 0}%`;
        };
        addEventListener("scroll", onScroll, { passive: true });
        onScroll();

        // Stat count-up (skipped for reduced-motion users)
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
          for (const el of document.querySelectorAll<HTMLElement>(".stat b")) {
            const target = Number(el.textContent?.replace(/,/g, ""));
            if (!Number.isFinite(target) || el.textContent?.includes("%")) continue;
            const t0 = performance.now();
            const tick = (t: number) => {
              const p = Math.min(1, (t - t0) / 900);
              const eased = 1 - Math.pow(1 - p, 3);
              el.textContent = Math.round(target * eased).toLocaleString("en-GB");
              if (p < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          }
        }
      });
    </script>
  </body>
</html>
