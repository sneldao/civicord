---
import { getCollection } from "astro:content";
import { ClientRouter } from "astro:transitions";
import CommandPalette from "../components/CommandPalette.astro";
import MobileEssentials from "../components/MobileEssentials.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import WebMCP from "../components/WebMCP.astro";
import { pickLeadWalkback, scopeExplanation } from "../lib/walkback";
import "../styles/global.css";
import constituenciesRaw from "../data/constituencies.json";
import claimDiffsRaw from "../data/claim_diffs.json";

let constituencies: any[] = [];
try {
  const raw: any = constituenciesRaw as any;
  const arr = Array.isArray(raw) ? raw : Array.isArray(raw?.default) ? raw.default : [];
  if (arr.length) constituencies = arr;
} catch {}
const withSites = constituencies.filter((c) => c.stats.sites > 0).length;
const officialSeats = constituencies.some((c) => c.gssCode);
const seatsTotal = constituencies.length || 650;
const seatsWithSites = withSites || (officialSeats ? seatsTotal - 17 : 0);
const seatMeta = !constituencies.length
  ? `${seatsWithSites} of ${seatsTotal} seats`
  : officialSeats
    ? `${seatsWithSites} of ${seatsTotal} seats`
    : `${withSites.toLocaleString("en-GB")} places named on candidate websites`;

const all = await getCollection("candidates");
const candidates = all.map((e) => e.data);
const lead = pickLeadWalkback(claimDiffsRaw as { byPerson?: Record<string, any> }, candidates);
const leadChecked = lead?.checkedAt && /^\d{4}-\d{2}-\d{2}$/.test(lead.checkedAt)
  ? new Date(`${lead.checkedAt}T00:00:00Z`).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })
  : lead?.checkedAt ?? "";
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="A sentence a UK campaign published in April 2025 that was not on the later homepage, with its source. Civicord keeps the public record of what campaigns published, and what changed."
    />
    <meta property="og:title" content="Civicord — the public record for political websites" />
    <meta
      property="og:description"
      content="A sentence a UK campaign published in April 2025 that was not on the later homepage, with its source."
    />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Civicord — the public record for political websites</title>
    <ClientRouter />
  </head>
  <body class="reveal-root door-page">
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="masthead door-masthead">
      <h1 class="wordmark">Civicord<span class="dot">.</span></h1>
      <p class="lede door-lede">What a UK campaign published, and what the later homepage no longer contained.</p>
    </header>

    <main id="main" tabindex="-1">
      {lead ? (
        <article class="walkback-lead" id="walkback-lead" aria-labelledby="walkback-kicker">
          <p class="walkback-kicker" id="walkback-kicker">No longer found · April 2025 → {leadChecked}</p>
          <blockquote class="walkback-quote">{lead.text}</blockquote>
          <p class="walkback-source">
            Source: {lead.name}{lead.party ? `, ${lead.party}` : ""}{lead.seat ? `, ${lead.seat}` : ""}.
            This sentence is in the April 2025 Campaign Lab scrape of{" "}
            <a href={lead.url} rel="noopener noreferrer">{lead.url}</a>
            {" "}and was not in the homepage fetched {leadChecked}.{" "}
            <a href={`/candidates/${lead.personId}#claims`}>Read the before and after</a>.
          </p>
          <p class="walkback-scope muted">{scopeExplanation(lead.scopeNote)}</p>
          <div class="door-cta" role="group" aria-label="Continue from this sentence">
            <a class="btn-primary" href={`/candidates/${lead.personId}#claims`}>Open this record</a>
            <a class="btn-ghost" href={`/candidates/${lead.personId}#correction`}>Propose a correction</a>
          </div>
          <p class="walkback-next">
            <a href="/steward">Roster digest</a>
            {" · "}
            <a href="/journalists">Journalist leads</a>
            {" · "}
            <a href="/browse">Ledger</a>
            {" · "}
            <a href="/uk">United Kingdom</a>
            {" · "}
            <a href="/methodology#verified">What is verified, and what is not</a>
          </p>
        </article>
      ) : (
        <p id="walkback-lead">No deleted sentence is stored in this snapshot.</p>
      )}

      <section class="future door-regions" id="regions" aria-label="Regions" data-reveal>
        <h2>Built for one election. Designed for any.</h2>
        <p class="muted future-lede">
          Roster + crawl + a place to keep the record. Pick a region.
        </p>
        <div class="future-grid" data-reveal-stagger>
          <a class="future-card is-live" href="/uk">
            <span class="fc-status">Live now</span>
            <b class="vt-uk-title">United Kingdom</b>
            <span class="fc-meta">{candidates.length.toLocaleString("en-GB")} candidates · {seatMeta} · Sept 2026</span>
            <span class="fc-cta">Explore the dataset ↗</span>
          </a>
          <a class="future-card" href="https://github.com/sneldao/civicord/issues">
            <span class="fc-status">Propose</span>
            <b>France</b>
            <span class="fc-meta">577 circonscriptions</span>
            <span class="fc-cta">Start a region ↗</span>
          </a>
          <a class="future-card" href="https://github.com/sneldao/civicord/issues">
            <span class="fc-status">Propose</span>
            <b>United States</b>
            <span class="fc-meta">435 districts</span>
            <span class="fc-cta">Start a region ↗</span>
          </a>
          <a class="future-card" href="/methodology">
            <span class="fc-status">Blueprint</span>
            <b>Your democracy</b>
            <span class="fc-meta">Bring a roster and a crawl</span>
            <span class="fc-cta">How it works ↗</span>
          </a>
        </div>
      </section>
    </main>

    <CommandPalette />
    <MobileEssentials />
    <ScrollReveal />
    <WebMCP />
  </body>
</html>
