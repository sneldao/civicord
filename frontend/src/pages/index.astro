---
import candidates from "../data/candidates.json";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

const websites = candidates.flatMap((c) => c.websites);
const audited = websites.filter((w) => w.audit);
const live = audited.filter((w) => w.audit?.statusClass === "live");
const dead = audited.filter((w) => w.audit?.statusClass === "dns_error");
const redirected = audited.filter((w) => w.audit?.redirected);
const onchain = candidates.filter((c) => c.onchain);
const pct = (n: number, d: number) => (d ? Math.round((n / d) * 100) : 0);

const statusLabels: Record<string, string> = {
  live: "Live",
  http_error: "HTTP error",
  dns_error: "Domain gone",
  connection_error: "Conn. failed",
  timeout: "Timed out",
  ssl_error: "SSL error",
  other_error: "Error",
  not_audited: "Not audited",
};

// Parties sorted by website count (most first) for the filter dropdown.
const partyCounts = new Map<string, number>();
for (const w of websites) for (const p of w.parties) partyCounts.set(p, (partyCounts.get(p) ?? 0) + 1);
const parties = [...partyCounts.entries()].sort((a, b) => b[1] - a[1]).map(([p]) => p);
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="When the election ended, candidate websites began to disappear. Civicord gives each UK parliamentary candidate a permanent, publicly verifiable record — who they were, what they published, and whether it's still there."
    />
    <meta property="og:title" content="Civicord — the public record candidates can't delete" />
    <meta
      property="og:description"
      content="A permanent, verifiable record of UK parliamentary candidate websites. What they published, and what happened to it."
    />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Civicord — a public record of UK candidate websites</title>
    <ClientRouter />
  </head>
  <body class="reveal-root">
    <div class="progress" aria-hidden="true"><b id="progress-bar"></b></div>
    <header class="masthead">
      <h1 class="wordmark">Civicord<span class="dot">.</span></h1>
      <p class="lede">
        When the election ended, candidate websites began to disappear. Civicord
        gives every UK parliamentary candidate a permanent, publicly verifiable
        record — who they were, what they published, and whether it's still there.
      </p>
      <p class="tagline">
        Built on Campaign Lab's April 2025 scrape of 2,375 candidates, keyed on
        Democracy Club person IDs, recorded as names on the Ethereum Name Service.
      </p>
    </header>

    <section class="stats" aria-label="Audit summary">
      <div class="stat"><b>{candidates.length.toLocaleString("en-GB")}</b><span>Candidates</span></div>
      <div class="stat"><b>{websites.length.toLocaleString("en-GB")}</b><span>Websites</span></div>
      <div class="stat"><b>{audited.length ? pct(live.length, audited.length) : "—"}%</b><span>Still live</span></div>
      <div class="stat"><b>{dead.length.toLocaleString("en-GB")}</b><span>Domains gone</span></div>
      <div class="stat"><b>{redirected.length.toLocaleString("en-GB")}</b><span>Redirected</span></div>
    </section>

    <section class="how" aria-label="How Civicord works">
      <h2>How it works</h2>
      <ol>
        <li>
          <b>Collect.</b> Campaign Lab scraped every candidate's campaign website in
          April 2025. We've re-checked them all: some are live, some have vanished,
          some now sell insurance.
        </li>
        <li>
          <b>Record.</b> Each candidate gets a permanent public name —
          <code>p1234.civicord.eth</code> — holding their website, status, and
          archived evidence. Once written, records can't be quietly edited or deleted.
        </li>
        <li>
          <b>Verify.</b> You don't need an account, a wallet, or our permission.
          Every claim on this site links to the public record behind it — check it
          yourself, any time, forever.
        </li>
      </ol>
    </section>

    <p class="method">
      Liveness audited 2026-09-07, ~17 months after the scrape — 36% of sites are already
      gone or broken. “Live” means responding <em>and</em> still mentioning the candidate;
      ↳ marks URLs that now redirect elsewhere.
      <a href="/methodology">Methodology ↗</a>
    </p>

    {onchain.length > 0 && (
      <p class="ens-note">
        <b>{onchain.length.toLocaleString("en-GB")} of {candidates.length.toLocaleString("en-GB")}</b>
        candidates already have a permanent public name. Look for
        <span class="onchain-chip">On-chain ✓</span> next to their name.
      </p>
    )}

    <div class="filterbar">
      <input id="q" type="search" placeholder="Filter by candidate, party, website…" autocomplete="off" />
      <label class="visually-hidden" for="status">Filter by status</label>
      <select id="status">
        <option value="all">All statuses</option>
        {Object.entries(statusLabels).map(([value, label]) => <option value={value}>{label}</option>)}
      </select>
      <label class="visually-hidden" for="party">Filter by party</label>
      <select id="party">
        <option value="all">All parties</option>
        {parties.map((p) => <option value={p.toLowerCase()}>{p}</option>)}
      </select>
      <span id="count" class="count"></span>
    </div>

    <table>
      <thead>
        <tr><th>Candidate</th><th>Party</th><th>Election</th><th>Website</th><th>Status</th></tr>
      </thead>
      <tbody>
        {candidates.flatMap((c, ci) =>
          c.websites.map((w) => {
            const st = w.audit?.statusClass ?? "not_audited";
            return (
              <tr
                style={`--row-i:${ci % 14}`}
                data-status={st}
                data-party={w.parties.map((p) => p.toLowerCase()).join(" ")}
                data-haystack={`${c.name} ${w.parties.join(" ")} ${w.elections[0] ?? ""} ${w.url}`.toLowerCase()}
              >
                <td>
                  <a href={`/candidates/${c.id}`}>{c.name}</a>
                  {c.onchain && <span class="onchain-chip" title={`${c.onchain.ens} — permanent public record`}>On-chain ✓</span>}
                </td>
                <td class="muted">{w.parties.join(", ")}</td>
                <td class="muted">{w.elections[0]}</td>
                <td class="url">
                  <a class="url" href={w.url} rel="noopener noreferrer" title={w.url}>
                    {w.url.replace(/^https?:\/\//, "").replace(/\/$/, "")}
                  </a>
                </td>
                <td>
                  <span class={`badge ${st}`}>{statusLabels[st]}</span>
                  {w.audit?.redirected && <span class="redir" title={w.audit.finalUrl ?? ""}> ↳</span>}
                </td>
              </tr>
            );
          })
        )}
      </tbody>
    </table>

    <footer>
      <p>
        Data: Campaign Lab candidate-website scrape (April 2025) · Democracy Club person
        IDs · Liveness audit 2026-09-07 · Wayback history (in progress). Code AGPL-3.0 ·
        <a href="https://github.com/sneldao/civicord">github.com/sneldao/civicord</a>
      </p>
    </footer>

    <script>
      // astro:page-load fires on first load and after every <ClientRouter />
      // view-transition swap — hoisted module scripts otherwise run only once,
      // which would leave the filter/progress/count-up dead after returning
      // to this page via a view transition. The DOM is swapped fresh each
      // time, so re-running the setup is correct (no stale listeners).
      document.addEventListener("astro:page-load", () => {
        const q = document.getElementById("q") as HTMLInputElement;
        const status = document.getElementById("status") as HTMLSelectElement;
        const party = document.getElementById("party") as HTMLSelectElement | null;
        const count = document.getElementById("count")!;
        const rows = [...document.querySelectorAll<HTMLTableRowElement>("tbody tr")];
        const apply = () => {
          const needle = q.value.trim().toLowerCase();
          const want = status.value;
          const wantParty = party?.value ?? "all";
          let shown = 0;
          for (const tr of rows) {
            const show =
              (!needle || tr.dataset.haystack!.includes(needle)) &&
              (want === "all" || tr.dataset.status === want) &&
              (wantParty === "all" || (tr.dataset.party ?? "").split(" ").includes(wantParty));
            tr.hidden = !show;
            if (show) shown++;
          }
          count.textContent = `${shown.toLocaleString("en-GB")} of ${rows.length.toLocaleString("en-GB")} entries`;
        };
        q.addEventListener("input", apply);
        status.addEventListener("change", apply);
        party?.addEventListener("change", apply);
        apply();

        // Scroll progress line
        const bar = document.getElementById("progress-bar")!;
        const onScroll = () => {
          const max = document.documentElement.scrollHeight - innerHeight;
          bar.style.width = `${max > 0 ? Math.min(100, (scrollY / max) * 100) : 0}%`;
        };
        addEventListener("scroll", onScroll, { passive: true });
        onScroll();

        // Stat count-up (skipped for reduced-motion users)
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
          for (const el of document.querySelectorAll<HTMLElement>(".stat b")) {
            const target = Number(el.textContent?.replace(/,/g, ""));
            if (!Number.isFinite(target) || el.textContent?.includes("%")) continue;
            const t0 = performance.now();
            const tick = (t: number) => {
              const p = Math.min(1, (t - t0) / 900);
              const eased = 1 - Math.pow(1 - p, 3);
              el.textContent = Math.round(target * eased).toLocaleString("en-GB");
              if (p < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          }
        }
      });
    </script>
  </body>
</html>
