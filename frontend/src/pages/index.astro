---
import { getCollection } from "astro:content";
import { ClientRouter } from "astro:transitions";
import CommandPalette from "../components/CommandPalette.astro";
import DoorField from "../components/DoorField.astro";
import MobileEssentials from "../components/MobileEssentials.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import WebMCP from "../components/WebMCP.astro";
import "../styles/global.css";
import constituenciesRaw from "../data/constituencies.json";

let constituencies: any[] = [];
try {
  const raw: any = constituenciesRaw as any;
  const arr = Array.isArray(raw) ? raw : Array.isArray(raw?.default) ? raw.default : [];
  if (arr.length) constituencies = arr;
} catch {}
const withSites = constituencies.filter((c) => c.stats.sites > 0).length;
const seatsTotal = constituencies.length || 650;
const seatsWithSites = withSites || seatsTotal - 17;

const all = await getCollection("candidates");
const candidates = all.map((e) => e.data);
const websites = candidates.flatMap((c) => c.websites);
const audited = websites.filter((w) => w.audit);
const live = audited.filter((w) => w.audit?.statusClass === "live");
const pct = (n: number, d: number) => (d ? Math.round((n / d) * 100) : 0);
const livePct = audited.length ? pct(live.length, audited.length) : 0;
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Inspect political website audit results and source excerpts. Public ENS fields on Sepolia testnet; UK first."
    />
    <meta property="og:title" content="Civicord — the public record for political websites" />
    <meta
      property="og:description"
      content="Inspect political website audit results and source excerpts. Public ENS fields on Sepolia testnet; UK first."
    />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Civicord — the public record for political websites</title>
    <ClientRouter />
  </head>
  <body class="reveal-root door-page">
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="door-hero">
      <header class="masthead door-masthead">
        <h1 class="wordmark">Civicord<span class="dot">.</span></h1>
        <p class="lede door-lede">
          Political websites can disappear after an election. Civicord helps you
          inspect what was captured, what the audit found, and the public record behind it.
        </p>
        <p class="tagline door-support">No account, no wallet. UK first.</p>
        <p class="tagline door-support muted">
          Sepolia prototype · URL, status and name recorded on-chain ·{" "}
          <a href="/methodology#permanence">permanent content storage planned</a>.
        </p>
        <div class="door-cta" role="group" aria-label="Get started">
          <a class="btn-primary" href="/browse">Find a candidate or constituency →</a>
          <a class="btn-ghost" href="/candidates/5693">See a worked example</a>
        </div>
      </header>

      <a class="door-visual" href="/uk" aria-label={`United Kingdom genesis dataset — ${livePct}% of audited URLs responding`}>
        <DoorField livePct={livePct} candidates={candidates.length} />
        <span class="door-visual-cta">Open the UK record ↗</span>
      </a>
    </div>

    <main id="main" tabindex="-1">
      <section class="persona-doors" aria-labelledby="doors-title">
        <h2 id="doors-title">Choose how you work with the record</h2>
        <p class="muted">Same audit facts, shaped around the question you actually arrive with.</p>
        <div class="feature-grid">
          <a class="feature-card feature-card--wide" href="/steward">
            <span>
              <span class="f-label">For roster stewards</span>
              <h3>I look after a roster of campaign sites</h3>
              <span class="f-meta">What died, what now points at a parked domain, what changed — grouped by action needed, with CSV export per group.</span>
              <span class="f-cta">Open the roster digest →</span>
            </span>
            <span class="wide-cta" aria-hidden="true">{livePct}% responding<br />last audit · Sept 2026</span>
          </a>
          <a class="feature-card" href="/journalists"><span class="f-label">For journalists</span><h3>The story is in the change</h3><span class="f-meta">Three pre-filtered leads from the change feed — dead domains, surname-absent pages, transformed content — each one citable.</span><span class="f-cta">See the leads →</span></a>
          <a class="feature-card" href="/browse?change=repurposed_suspect"><span class="f-label">For researchers</span><h3>Longitudinal, stable, citable</h3><span class="f-meta">2,375 candidate records keyed on Democracy Club IDs, filterable by outcome, party and place. Copy citation on every record.</span><span class="f-cta">Enter the ledger →</span></a>
        </div>
        <p class="also-links">
          Also: <a href="/candidates/5693#verification">verify a record on-chain</a> · <a href="/candidates/5693#agent-view">agent view</a> · <a href="https://civicord-aieyq.bazgateway.com/mcp">MCP endpoint</a>
        </p>
      </section>

      <section class="future door-regions" id="regions" aria-label="Regions" data-reveal>
        <h2>Built for one election. Designed for any.</h2>
        <p class="muted future-lede">
          Roster + crawl + a place to keep the record. Pick a region.
        </p>
        <div class="future-grid" data-reveal-stagger>
          <a class="future-card is-live" href="/uk">
            <span class="fc-status">Live now</span>
            <b class="vt-uk-title">United Kingdom</b>
            <span class="fc-meta">{candidates.length.toLocaleString("en-GB")} candidates · {seatsWithSites} of {seatsTotal} seats · Sept 2026</span>
            <span class="fc-cta">Explore the dataset ↗</span>
          </a>
          <a class="future-card" href="https://github.com/sneldao/civicord/issues">
            <span class="fc-status">Propose</span>
            <b>France</b>
            <span class="fc-meta">577 circonscriptions</span>
            <span class="fc-cta">Start a region ↗</span>
          </a>
          <a class="future-card" href="https://github.com/sneldao/civicord/issues">
            <span class="fc-status">Propose</span>
            <b>United States</b>
            <span class="fc-meta">435 districts</span>
            <span class="fc-cta">Start a region ↗</span>
          </a>
          <a class="future-card" href="/methodology">
            <span class="fc-status">Blueprint</span>
            <b>Your democracy</b>
            <span class="fc-meta">Bring a roster and a crawl</span>
            <span class="fc-cta">How it works ↗</span>
          </a>
        </div>
      </section>
    </main>

    <CommandPalette />
    <MobileEssentials />
    <ScrollReveal />
    <WebMCP />
  </body>
</html>
