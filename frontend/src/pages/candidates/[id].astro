---
import { getCollection } from "astro:content";
import { ClientRouter } from "astro:transitions";
import { partyLiveShare } from "../../lib/cohorts";
import "../../styles/global.css";

export async function getStaticPaths() {
  const all = await getCollection("candidates");
  return all.map((entry) => ({ params: { id: entry.data.id }, props: { person: entry.data } }));
}

const { person } = Astro.props;
const statusLabels: Record<string, string> = {
  live: "Live",
  http_error: "HTTP error",
  dns_error: "Domain gone",
  timeout: "Timed out",
  ssl_error: "SSL error",
  connection_error: "Connection failed",
  other_error: "Error",
};
const parties = [...new Set(person.websites.flatMap((w) => w.parties))];
const elections = [...new Set(person.websites.flatMap((w) => w.elections))];
const firstStatus = person.websites[0]?.audit?.statusClass;
const siteWord =
  firstStatus === "live" ? "still live"
  : firstStatus === "dns_error" ? "taken offline"
  : firstStatus ? `flagged: ${statusLabels[firstStatus] ?? firstStatus}` : "archived";
const ens = person.onchain?.ens ?? `p${person.id}.civicord.eth`;
const ensUrl = `https://app.ens.domains/${ens}`;
const resolverUrl =
  "https://sepolia.etherscan.io/address/0x340d18ecb0bbe7bd67b53e836f2f68cf620aee67#readContract";

// Verdict banner (verdict-first page): overall status across the websites.
const verdict =
  person.websites.every((w) => w.audit?.statusClass === "live") ? "live"
  : person.websites.some((w) => w.audit?.statusClass === "live") ? "mixed"
  : person.websites.every((w) => ["dns_error", "connection_error"].includes(w.audit?.statusClass ?? ""))
    ? "gone" : "unknown";
const verdictCopy: Record<string, [string, string]> = {
  live: ["Still live ✓", `${person.name}'s campaign site responds and still mentions them — checked September 2026.`],
  mixed: ["Partly live ~", `Some of ${person.name}'s recorded sites are live, others are gone or broken — checked September 2026.`],
  gone: ["Gone ✕", `${person.name}'s recorded campaign sites no longer resolve — checked September 2026.`],
  unknown: ["Archived record", `Civicord holds what ${person.name} published — scraped April 2025, permanence recorded on-chain.`],
};

// Cold-arrival context line + breadcrumb: party / first constituency.
const party = parties[0] ?? "Candidate";
const seat = person.websites[0]?.posts?.[0] ?? elections[0] ?? "";

// Prev / next by id order for the "poking around" loop.
const ids = (await getCollection("candidates")).map((e) => e.data.id).sort();
const at = ids.indexOf(person.id);
const prevId = at > 0 ? ids[at - 1] : null;
const nextId = at >= 0 && at < ids.length - 1 ? ids[at + 1] : null;

// Comparative context: this person's party vs the site-wide average.
// Turns a record into insight ("Labour avg 64% live; this candidate: gone").
// Falls back: exact party → any party containing its first word ("Labour" matches
// "Labour Party", "Labour and Co-operative Party") → nothing (line hidden).
const shareByParty = await partyLiveShare();
const personShare =
  person.websites.length > 0
    ? person.websites.filter((w) => w.audit?.statusClass === "live").length / person.websites.length
    : null;
const findPartyShare = (name: string): [string, number] | null => {
  if (shareByParty.has(name)) return [name, shareByParty.get(name)!];
  const first = name.split(/\s+/)[0].toLowerCase();
  for (const [key, share] of shareByParty) {
    if (key.toLowerCase().split(/\s+/).includes(first)) return [key, share];
  }
  return null;
};
const compareFound = parties.map(findPartyShare).find((x) => x !== null) ?? null;
const compareParty = compareFound?.[0] ?? null;
const compareAvg = compareFound?.[1] ?? null;
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`Public record for UK parliamentary candidate ${person.name}: was their campaign website still live, gone, or repurposed — permanently recorded and publicly verifiable.`} />
    <meta property="og:title" content={`${person.name} — Civicord public record`} />
    <meta property="og:type" content="profile" />
    <meta
      property="og:description"
      content={`${person.name} stood for ${parties.join(", ") || "Parliament"}. Their campaign site was ${siteWord}. Civicord holds this permanently on-chain — see the record.`}
    />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{person.name} — Civicord</title>
    <ClientRouter />
  </head>
  <body class="reveal-root">
    <p class="crumb">
      <a href="/">Civicord</a> · <a href="/browse">Browse</a> / {party}{seat && <> / {seat}</>} / <b>{person.name}</b>
    </p>

    <p class="context-line">
      Campaign site{person.websites.length > 1 ? "s" : ""} for {person.name} ({party}{seat && ` — ${seat}`}),
      scraped April 2025, audited September 2026.
    </p>

    <header class="record-head">
      <h1>{person.name}</h1>
      <ul class="chips">
        {parties.map((p) => <li>{p}</li>)}
        {elections.map((e) => <li>{e}</li>)}
      </ul>
    </header>

    <p class={`verdict v-${verdict}`} role="status">
      <b>{verdictCopy[verdict][0]}</b> — {verdictCopy[verdict][1]}
    </p>

    {compareAvg !== null && personShare !== null && (
      <p class="compare-line">
        {compareParty}: <b>{Math.round(compareAvg * 100)}% of sites live</b> across the party ·{" "}
        this candidate: <b>{personShare >= 1 ? "live" : personShare <= 0 ? "gone" : `${Math.round(personShare * 100)}% live`}</b>.{" "}
        <a href={`/browse?party=${encodeURIComponent(compareParty.toLowerCase())}`}>See the cohort ↗</a>
      </p>
    )}

    <ol class="timeline" aria-label="Record history">
      <li><b>Apr 2025</b><span>scraped</span></li>
      <li aria-hidden="true" class="tick">→</li>
      <li><b>Sep 2026</b><span>audited</span></li>
      <li aria-hidden="true" class="tick">→</li>
      <li class={person.onchain ? "" : "pending"}>
        <b>{person.onchain ? "Recorded" : "Pending"}</b><span>on-chain</span>
      </li>
    </ol>

    <section class="entries">
      <h2>Websites</h2>
      {person.websites.map((w) => {
        const st = w.audit?.statusClass ?? "unknown";
        return (
          <article class={`entry st-${st}`}>
            <header>
              <span class={`badge ${st}`}>
                {w.audit ? (statusLabels[w.audit.statusClass] ?? w.audit.statusClass) : "Not audited"}
              </span>
              <a class="site-url" href={w.url} rel="noopener noreferrer">{w.url}</a>
            </header>
            <ul class="facts">
              {w.audit?.statusCode && <li>HTTP {w.audit.statusCode} on 2026-09-07</li>}
              {w.audit?.redirected && w.audit.finalUrl && (
                <li class="fact-redir">
                  ↳ now redirects to <a href={w.audit.finalUrl} rel="noopener noreferrer">{w.audit.finalUrl}</a>
                </li>
              )}
              {w.audit?.nameFound === true && <li>Candidate surname still present on the current page</li>}
              {w.audit?.nameFound === false && (
                <li class="fact-warn">Surname absent from the current page — site may have been repurposed</li>
              )}
            </ul>
          </article>
        );
      })}
    </section>

    {person.pages.length > 0 && (
      <details class="specimens">
        <summary>Archived scrape — April 2025 (Campaign Lab) · {person.pages.length} pages</summary>
        <table>
          <thead>
            <tr><th>Page</th><th>Chars</th><th>Opening text</th></tr>
          </thead>
          <tbody>
            {person.pages.map((p) => (
              <tr>
                <td title={p.key}>{p.key.split("/").pop()}</td>
                <td>{p.chars.toLocaleString("en-GB")}</td>
                <td><pre>{p.snippet}…</pre></td>
              </tr>
            ))}
          </tbody>
        </table>
      </details>
    )}

    {person.onchain && (
      <section class="ens-record" aria-label="Public record">
        <h2>Public record <span class="onchain-chip">On-chain ✓</span></h2>
        <p>
          Permanent public name:{" "}
          <button type="button" class="ens-copy" data-copy={ens} title="Copy the ENS name">
            <code>{ens}</code>
          </button>
          .{" "}
          {person.onchain.status && <>Recorded status: <b>{person.onchain.status}</b>. </>}
          It holds this page's claims — website, status, evidence — in a public
          register that can't be quietly edited or deleted.
        </p>
        <ul class="ens-links">
          <li><a href={ensUrl} rel="noopener noreferrer">View the record ↗</a></li>
          <li><a href={resolverUrl} rel="noopener noreferrer">Verify on the register ↗</a></li>
        </ul>
      </section>
    )}

    <nav class="prevnext" aria-label="More candidates">
      {prevId ? <a href={`/candidates/${prevId}`}>← Previous candidate</a> : <span />}
      <a href="/browse">Browse ledger</a>
      {nextId ? <a href={`/candidates/${nextId}`}>Next candidate →</a> : <span />}
    </nav>

    <footer>
      <p>
        Civicord record · permanent public identity via the Ethereum Name Service
        (no account or wallet needed to read) ·
        <a href="https://github.com/sneldao/civicord">github.com/sneldao/civicord</a>
      </p>
    </footer>

    <script>
      // Copy the ENS name on click (progressive enhancement; view-transition safe).
      document.addEventListener("astro:page-load", () => {
        const btn = document.querySelector<HTMLButtonElement>(".ens-copy");
        btn?.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(btn.dataset.copy!);
          } catch {
            const ta = document.createElement("textarea");
            ta.value = btn.dataset.copy!;
            document.body.appendChild(ta);
            ta.select();
            document.execCommand("copy");
            ta.remove();
          }
          btn.classList.add("copied");
          setTimeout(() => btn.classList.remove("copied"), 1200);
        });
      });
    </script>
  </body>
</html>
