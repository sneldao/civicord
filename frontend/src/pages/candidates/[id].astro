---
import { getCollection } from "astro:content";
import PeekSheet from "../../components/PeekSheet.astro";
import CommandPalette from "../../components/CommandPalette.astro";
import MobileEssentials from "../../components/MobileEssentials.astro";
import ScrollReveal from "../../components/ScrollReveal.astro";
import AgentView from "../../components/AgentView.astro";
import WebMCP from "../../components/WebMCP.astro";
import { ClientRouter } from "astro:transitions";
import { partyLiveShare } from "../../lib/cohorts";
import "../../styles/global.css";
import constituenciesRaw from "../../data/constituencies.json";
import hexesRaw from "../../data/hexes.json";

export async function getStaticPaths() {
  const all = await getCollection("candidates");
  return all.map((entry) => ({ params: { id: entry.data.id }, props: { person: entry.data } }));
}

const { person } = Astro.props;
const statusLabels: Record<string, string> = {
  live: "Live",
  http_error: "HTTP error",
  dns_error: "Domain gone",
  timeout: "Timed out",
  ssl_error: "SSL error",
  connection_error: "Connection failed",
  other_error: "Error",
};
const parties = [...new Set(person.websites.flatMap((w) => w.parties))];
const elections = [...new Set(person.websites.flatMap((w) => w.elections))];
const firstStatus = person.websites[0]?.audit?.statusClass;
const siteWord =
  firstStatus === "live" ? "still live"
  : firstStatus === "dns_error" ? "taken offline"
  : firstStatus ? `flagged: ${statusLabels[firstStatus] ?? firstStatus}` : "archived";
const ens = person.onchain?.ens ?? `p${person.id}.civicord.eth`;
const ensUrl = `https://app.ens.domains/${ens}`;
const resolverUrl =
  "https://sepolia.etherscan.io/address/0x340d18ecb0bbe7bd67b53e836f2f68cf620aee67#readContract";

// Verdict banner (verdict-first page): overall status across the websites.
const verdict =
  person.websites.every((w) => w.audit?.statusClass === "live") ? "live"
  : person.websites.some((w) => w.audit?.statusClass === "live") ? "mixed"
  : person.websites.every((w) => ["dns_error", "connection_error"].includes(w.audit?.statusClass ?? ""))
    ? "gone" : "unknown";
const verdictCopy: Record<string, [string, string]> = {
  live: ["Still live ✓", `${person.name}'s campaign site responds and still mentions them — checked September 2026.`],
  mixed: ["Partly live ~", `Some of ${person.name}'s recorded sites are live, others are gone or broken — checked September 2026.`],
  gone: ["Gone ✕", `${person.name}'s recorded campaign sites no longer resolve — checked September 2026.`],
  unknown: ["Archived record", `Civicord holds what ${person.name} published — scraped April 2025, permanence recorded on-chain.`],
};

// Cold-arrival context line + breadcrumb: party / first constituency.
const party = parties[0] ?? "Candidate";
const seat = person.websites[0]?.posts?.[0] ?? elections[0] ?? "";

// --- Constituency seat-context (links candidate → place → survival) ---
function slugifyConstituency(name: string): string {
  let s = name.normalize("NFD").replace(/[\u0300-\u036f]/g, "");
  s = s.replace(/&/g, " and ");
  s = s.toLowerCase();
  s = s.replace(/[^a-z0-9]+/g, "-");
  s = s.replace(/^-+|-+$/g, "").replace(/--+/g, "-");
  return s;
}
function thumbFills(livePct: number): string {
  if (livePct >= 66) return "var(--live)";
  if (livePct >= 40) return "var(--warn)";
  return "var(--gone)";
}
const rawConstituencies: any = constituenciesRaw as any;
const constituenciesArray: any[] = Array.isArray(rawConstituencies) ? rawConstituencies : Array.isArray(rawConstituencies?.default) ? rawConstituencies.default : [];
const constituencyByName = new Map<string, any>(constituenciesArray.map((c: any) => [c.name, c]));
const constituencyBySlug = new Map<string, any>(constituenciesArray.map((c: any) => [c.slug, c]));
const distinctSeatNames: string[] = [...new Set(person.websites.flatMap((w: any) => (w.posts ?? []) as string[]))].filter(Boolean) as string[];
const seatInfos: Array<{ name: string; constituency: any | null; hex: any | null }> = distinctSeatNames.map((name) => {
  let c = constituencyByName.get(name) ?? null;
  if (!c) c = constituencyBySlug.get(slugifyConstituency(name)) ?? null;
  let hex: any = null;
  if (c) {
    try {
      const rawHex: any = hexesRaw as any;
      const obj = Array.isArray(rawHex?.hexes) ? rawHex : rawHex?.default ?? rawHex;
      const hexes: any[] = obj?.hexes ?? [];
      hex = hexes.find((h: any) => h.slug === c.slug) || null;
    } catch {}
  }
  return { name, constituency: c, hex };
});
const primarySeatInfo = seatInfos.find((s) => s.constituency) ?? (seatInfos[0] ? seatInfos[0] : null);

// Prev / next by id order for the "poking around" loop.
const ids = (await getCollection("candidates")).map((e) => e.data.id).sort();
const at = ids.indexOf(person.id);
const prevId = at > 0 ? ids[at - 1] : null;
const nextId = at >= 0 && at < ids.length - 1 ? ids[at + 1] : null;

// Comparative context: this person's party vs the site-wide average.
// Turns a record into insight ("Labour avg 64% live; this candidate: gone").
// Falls back: exact party → any party containing its first word ("Labour" matches
// "Labour Party", "Labour and Co-operative Party") → nothing (line hidden).
const shareByParty = await partyLiveShare();
const personShare =
  person.websites.length > 0
    ? person.websites.filter((w) => w.audit?.statusClass === "live").length / person.websites.length
    : null;
const findPartyShare = (name: string): [string, number] | null => {
  if (shareByParty.has(name)) return [name, shareByParty.get(name)!];
  const first = name.split(/\s+/)[0].toLowerCase();
  for (const [key, share] of shareByParty) {
    if (key.toLowerCase().split(/\s+/).includes(first)) return [key, share];
  }
  return null;
};
const compareFound = parties.map(findPartyShare).find((x) => x !== null) ?? null;
const compareParty = compareFound?.[0] ?? null;
const compareAvg = compareFound?.[1] ?? null;
// Pre-computed for the compare line: keeps the template free of ternaries the
// Astro parser mis-reads as fragment shorthand (astro(1002)).
const personShareText =
  personShare === null ? "" : personShare >= 1 ? "live" : personShare <= 0 ? "gone" : `${Math.round(personShare * 100)}% live`;
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`Public record for UK parliamentary candidate ${person.name}: was their campaign website still live, gone, or repurposed — permanently recorded and publicly verifiable.`} />
    <meta property="og:title" content={`${person.name} — Civicord public record`} />
    <meta property="og:type" content="profile" />
    <meta
      property="og:description"
      content={`${person.name} stood for ${parties.join(", ") || "Parliament"}. Their campaign site was ${siteWord}. Civicord holds this permanently on-chain — see the record.`}
    />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{person.name} — Civicord</title>
    <ClientRouter />
  </head>
  <body class="reveal-root">
    <a class="skip-link" href="#main">Skip to content</a>
    <p class="crumb">
      <a href="/">Civicord</a> · <a href="/uk">UK</a> · <a href="/browse">Browse</a> / {party}{primarySeatInfo?.constituency ? <> / <a href={`/constituencies/${primarySeatInfo.constituency.slug}`}>{seat}</a></> : seat ? <> / {seat}</> : null} / <b>{person.name}</b>
    </p>

    <p class="context-line">
      Campaign site{person.websites.length > 1 ? "s" : ""} for {person.name} ({party}{primarySeatInfo?.constituency ? <> — <a href={`/constituencies/${primarySeatInfo.constituency.slug}`}>{seat}</a></> : seat ? ` — ${seat}` : ""}),
      scraped April 2025, audited September 2026.
    </p>

    <main id="main" tabindex="-1">
    <header class="record-head">
      <h1>{person.name}</h1>
      <ul class="chips">
        {parties.map((p) => <li>{p}</li>)}
        {elections.map((e) => <li>{e}</li>)}
      </ul>
    </header>

    <p class={`verdict v-${verdict}`} role="status">
      <b>{verdictCopy[verdict][0]}</b> — {verdictCopy[verdict][1]}
    </p>

    {compareAvg !== null && personShare !== null && compareParty && (
      <p class="compare-line">
        {compareParty}: <b>{Math.round(compareAvg * 100)}% of sites live</b> across the party ·
        this candidate: <b>{personShareText}</b>.
        <a href={`/browse?party=${encodeURIComponent(compareParty.toLowerCase())}`}>See the cohort ↗</a>
      </p>
    )}

    {primarySeatInfo?.constituency && (
      <section class="seat-context" aria-label={`Constituency — ${primarySeatInfo.constituency.name}`}>
        <a class="seat-hex" href={`/constituencies/${primarySeatInfo.constituency.slug}`} aria-label={`View ${primarySeatInfo.constituency.name}`}>
          {primarySeatInfo.hex ? (
            <svg viewBox="0 0 120 120" role="img" aria-hidden="true" width="56" height="56" class="thumb-hex">
              {(() => {
                const pts: [number, number][] = primarySeatInfo.hex.points;
                const xs = pts.map(([x]: [number, number]) => x);
                const ys = pts.map(([, y]: [number, number]) => y);
                const minX = Math.min(...xs), maxX = Math.max(...xs), minY = Math.min(...ys), maxY = Math.max(...ys);
                const w = maxX - minX || 1, h = maxY - minY || 1;
                const norm = pts.map(([x, y]: [number, number]) => `${((x - minX) / w) * 110 + 5},${((y - minY) / h) * 110 + 5}`).join(" ");
                const dotCount = primarySeatInfo.constituency.stats.sites === 0 ? 0 : primarySeatInfo.constituency.stats.livePct < 40 ? 3 : primarySeatInfo.constituency.stats.livePct < 66 ? 2 : 1;
                return (
                  <>
                    <polygon points={norm} fill={primarySeatInfo.constituency.stats.sites === 0 ? "var(--paper-deep)" : thumbFills(primarySeatInfo.constituency.stats.livePct)} fill-opacity={primarySeatInfo.constituency.stats.sites === 0 ? 0.35 : 0.92} stroke="var(--ink)" stroke-width="1.2" stroke-linejoin="round" />
                    {primarySeatInfo.constituency.stats.sites === 0 && <circle cx="60" cy="60" r="8" fill="var(--ink)" opacity="0.18" />}
                    {Array.from({ length: dotCount }).map((_, i) => {
                      const off: [number, number][] = [[0, 0], [10, 14], [-10, -14]];
                      const [ox, oy] = off[i] ?? [0, 0];
                      return <circle cx={60 + ox} cy={60 + oy} r={primarySeatInfo.constituency.stats.livePct < 40 ? 6.5 : primarySeatInfo.constituency.stats.livePct < 66 ? 5 : 3.6} fill="var(--paper)" fill-opacity={primarySeatInfo.constituency.stats.livePct < 40 ? 0.88 : 0.45} />;
                    })}
                  </>
                );
              })()}
            </svg>
          ) : (
            <span class="thumb-hex thumb-hex--empty" aria-hidden="true"></span>
          )}
        </a>
        <div class="seat-copy">
          <p class="seat-line">
            Stood in <a href={`/constituencies/${primarySeatInfo.constituency.slug}`}><b>{primarySeatInfo.constituency.name}</b></a>
            {primarySeatInfo.constituency.stats.sites > 0 ? (
              <> — <b>{primarySeatInfo.constituency.stats.live} of {primarySeatInfo.constituency.stats.sites} sites live ({primarySeatInfo.constituency.stats.livePct}%)</b><span class="muted"> · {primarySeatInfo.constituency.stats.gone} gone · {primarySeatInfo.constituency.stats.redirected} redirected</span></>
            ) : (
              <> — <span class="muted">no scraped site in this seat (17 like it)</span></>
            )}
          </p>
          <p class="muted seat-meta">
            {primarySeatInfo.constituency.gssCode} · {primarySeatInfo.constituency.region}{primarySeatInfo.constituency.country ? ` · ${primarySeatInfo.constituency.country}` : ""}{primarySeatInfo.constituency.electorate ? ` · ${primarySeatInfo.constituency.electorate.toLocaleString("en-GB")} electorate` : ""} · Halftone: more / larger paper dots = more gone.
          </p>
          <div class="seat-actions">
            <a class="btn-primary btn-sm" href={`/constituencies/${primarySeatInfo.constituency.slug}`}>View {primarySeatInfo.constituency.name} ↗</a>
            <a class="btn-ghost btn-sm" href={`/browse?constituency=${primarySeatInfo.constituency.slug}`}>Filtered ledger — {primarySeatInfo.constituency.stats.sites} sites ↗</a>
          </div>
          {seatInfos.length > 1 && (
            <p class="muted seat-also">Also stood in: {seatInfos.filter((s) => s.name !== primarySeatInfo.name).map((s, i) => (
              <span>{i > 0 && ", "}{s.constituency ? <a href={`/constituencies/${s.constituency.slug}`}>{s.name}</a> : s.name}</span>
            ))}</p>
          )}
        </div>
      </section>
    )}

    <ol class="timeline" aria-label="Record history">
      <li><b>Apr 2025</b><span>scraped</span></li>
      <li aria-hidden="true" class="tick">→</li>
      <li><b>Sep 2026</b><span>audited</span></li>
      <li aria-hidden="true" class="tick">→</li>
      <li class={person.onchain ? "" : "pending"}>
        <b>{person.onchain ? "Recorded" : "Pending"}</b><span>on-chain</span>
      </li>
    </ol>

    <section class="entries">
      <h2>Websites</h2>
      {person.websites.map((w) => {
        const st = w.audit?.statusClass ?? "unknown";
        return (
          <article class={`entry st-${st}`}>
            <header>
              <span class={`badge ${st}`}>
                {w.audit ? (statusLabels[w.audit.statusClass] ?? w.audit.statusClass) : "Not audited"}
              </span>
              <a class="site-url" href={w.url} rel="noopener noreferrer">{w.url}</a>
            </header>
            <ul class="facts">
              {w.audit?.statusCode && <li>HTTP {w.audit.statusCode} on 2026-09-07</li>}
              {w.audit?.redirected && w.audit.finalUrl && (
                <li class="fact-redir">
                  ↳ now redirects to <a href={w.audit.finalUrl} rel="noopener noreferrer">{w.audit.finalUrl}</a>
                </li>
              )}
              {w.audit?.nameFound === true && <li>Candidate surname still present on the current page</li>}
              {w.audit?.nameFound === false && (
                <li class="fact-warn">Surname absent from the current page — site may have been repurposed</li>
              )}
            </ul>
          </article>
        );
      })}
    </section>

    {person.pages.length > 0 && (
      <details class="specimens">
        <summary>Archived scrape — April 2025 (Campaign Lab) · {person.pages.length} pages</summary>
        <table>
          <thead>
            <tr><th>Page</th><th>Chars</th><th>Opening text</th></tr>
          </thead>
          <tbody>
            {person.pages.map((p) => (
              <tr>
                <td title={p.key}>{p.key.split("/").pop()}</td>
                <td>{p.chars.toLocaleString("en-GB")}</td>
                <td><pre>{p.snippet}…</pre></td>
              </tr>
            ))}
          </tbody>
        </table>
      </details>
    )}

    {person.onchain && (
      <section class="ens-record" aria-label="Public record">
        <h2>Public record <span class="onchain-chip">On-chain ✓</span></h2>
        <p>
          Permanent public name:{" "}
          <button type="button" class="ens-copy" data-copy={ens} title="Copy the ENS name">
            <code>{ens}</code>
          </button>
          .{" "}
          {person.onchain.status && <>Recorded status: <b>{person.onchain.status}</b>. </>}
          It holds this page's claims — website, status, evidence — in a public
          register that can't be quietly edited or deleted. Same registry also
          serves <code>p{person.id}.civicordhq.eth</code> (dual parent label).
        </p>
        <div
          class="ens-live"
          data-person-id={person.id}
          data-ens={ens}
          data-node={person.onchain.node ?? ""}
        >
          <button type="button" class="ens-verify-btn">Verify on-chain</button>
          <p class="ens-live-status muted" hidden>Reading Sepolia resolver…</p>
          <dl class="ens-live-texts" hidden></dl>
        </div>
        <ul class="ens-links">
          <li><a href={ensUrl} rel="noopener noreferrer">View the record ↗</a></li>
          <li><a href={resolverUrl} rel="noopener noreferrer">Open the register ↗</a></li>
        </ul>
      </section>
    )}

    <nav class="prevnext" aria-label="More candidates">
      {prevId ? <a href={`/candidates/${prevId}`}>← Previous candidate</a> : <span />}
      <a href="/browse">Browse ledger</a>
      {nextId ? <a href={`/candidates/${nextId}`}>Next candidate →</a> : <span />}
    </nav>
    </main>

    <AgentView mode="candidate" name={person.name} samplePersonId={person.id} />

    <footer>
      <p>
        Civicord record · permanent public identity via the Ethereum Name Service
        (no account or wallet needed to read) ·
        <a href="https://github.com/sneldao/civicord">github.com/sneldao/civicord</a>
      </p>
    </footer>

    <PeekSheet />
    <CommandPalette />
    <MobileEssentials />
    <ScrollReveal />
    <WebMCP />

    <script>
      // Copy the ENS name + live Sepolia text() verify (view-transition safe).
      document.addEventListener("astro:page-load", () => {
        const btn = document.querySelector<HTMLButtonElement>(".ens-copy");
        btn?.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(btn.dataset.copy!);
          } catch {
            const ta = document.createElement("textarea");
            ta.value = btn.dataset.copy!;
            document.body.appendChild(ta);
            ta.select();
            document.execCommand("copy");
            ta.remove();
          }
          btn.classList.add("copied");
          setTimeout(() => btn.classList.remove("copied"), 1200);
        });

        const live = document.querySelector<HTMLElement>(".ens-live");
        const verifyBtn = live?.querySelector<HTMLButtonElement>(".ens-verify-btn");
        const statusEl = live?.querySelector<HTMLElement>(".ens-live-status");
        const textsEl = live?.querySelector<HTMLDListElement>(".ens-live-texts");
        verifyBtn?.addEventListener("click", async () => {
          if (!live || !statusEl || !textsEl) return;
          const id = live.dataset.personId;
          if (!id) return;
          verifyBtn.disabled = true;
          statusEl.hidden = false;
          statusEl.textContent = "Reading Sepolia resolver via eth_call…";
          textsEl.hidden = true;
          textsEl.replaceChildren();
          try {
            const res = await fetch(`/api/ens?id=${encodeURIComponent(id)}`);
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || res.statusText);
            const entries = Object.entries(data.texts || {}).filter(
              ([, v]) => v != null && typeof v === "string" && v.length > 0
            );
            if (!entries.length) {
              statusEl.textContent = "No text records returned from the resolver.";
            } else {
              statusEl.textContent = `Live from Sepolia · ${data.source}`;
              for (const [key, value] of entries) {
                const dt = document.createElement("dt");
                dt.textContent = key;
                const dd = document.createElement("dd");
                dd.textContent = String(value);
                textsEl.append(dt, dd);
              }
              textsEl.hidden = false;
            }
          } catch (err) {
            statusEl.textContent = `Verify failed: ${err instanceof Error ? err.message : String(err)}`;
          } finally {
            verifyBtn.disabled = false;
          }
        });

        // Seat hex peeks in place when the sheet is mounted; plain link otherwise.
        const hex = document.querySelector<HTMLAnchorElement>(".seat-hex");
        if (hex && document.getElementById("peek-sheet")) {
          hex.addEventListener("click", (e) => {
            e.preventDefault();
            const name = hex.getAttribute("aria-label")?.replace(/^View /, "");
            window.dispatchEvent(
              new CustomEvent("civicord:peek", {
                detail: { slug: hex.getAttribute("href")?.split("/").pop(), name },
              }),
            );
          });
        }
      });
    </script>
  </body>
</html>
