---
import { getCollection } from "astro:content";
import { ClientRouter } from "astro:transitions";
import { cohortStats, statusCohorts } from "../lib/cohorts";
import HalftoneHexMap from "../components/HalftoneHexMap.astro";
import PeekSheet from "../components/PeekSheet.astro";
import CommandPalette from "../components/CommandPalette.astro";
import WebMCP from "../components/WebMCP.astro";
import "../styles/global.css";
import constituenciesRaw from "../data/constituencies.json";

let constituencies: any[] = [];
try {
  const raw: any = constituenciesRaw as any;
  const arr = Array.isArray(raw) ? raw : Array.isArray(raw?.default) ? raw.default : [];
  if (arr.length) constituencies = arr;
} catch {}
const constituenciesForSearch = constituencies.slice(0, 650).map((c) => ({ slug: c.slug, name: c.name }));

const all = await getCollection("candidates");
const candidates = all.map((e) => e.data).sort((a, b) => a.name.localeCompare(b.name));
const websites = candidates.flatMap((c) => c.websites);
const audited = websites.filter((w) => w.audit);
const live = audited.filter((w) => w.audit?.statusClass === "live");
const redirected = audited.filter((w) => w.audit?.redirected);
const pct = (n: number, d: number) => (d ? Math.round((n / d) * 100) : 0);
const GONE_CLASSES = ["dns_error", "connection_error"];
const gone = audited.filter((w) => GONE_CLASSES.includes(w.audit?.statusClass ?? ""));
const liveAndRedirected = live.filter((w) => w.audit?.redirected).length;
const onchain = candidates.filter((c) => c.onchain);
const sampleOnchain =
  onchain.find((c) => c.id === "5693") ??
  (onchain.length ? onchain[Math.floor(onchain.length / 2)] : null);
const seatsTotal = constituencies.length || 650;
const livePctNow = audited.length ? pct(live.length, audited.length) : 0;

const stats = await cohortStats();
const board = stats.parties.slice(0, 8);
const maxBoard = Math.max(...board.map((r) => r.sites), 1);
const cohorts = await statusCohorts();
const bySlug = Object.fromEntries(cohorts.map((c) => [c.slug, c]));
const randomIds = candidates.map((c) => c.id);
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="UK genesis dataset: candidate campaign sites scraped April 2025, re-checked 17 months later, recorded under public names. Browse the ledger, map, and cohorts."
    />
    <meta property="og:title" content="United Kingdom — Civicord genesis dataset" />
    <meta
      property="og:description"
      content="UK candidate campaign sites, audited and recorded. Browse the ledger, map the seats, and verify each claim."
    />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>United Kingdom — Civicord genesis dataset</title>
    <ClientRouter />
  </head>
  <body class="reveal-root">
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="progress" aria-hidden="true"><b id="progress-bar"></b></div>

    <header class="masthead">
      <div class="masthead-top">
        <p class="wordmark wordmark-link">
          <a href="/" aria-label="Civicord home">Civicord<span class="dot">.</span></a>
        </p>
        <details class="region-picker">
          <summary>
            <span class="rp-kicker">Region</span>
            <span class="rp-current">UK · genesis</span>
            <span class="rp-caret" aria-hidden="true">▾</span>
          </summary>
          <ul class="rp-list">
            <li class="rp-is-live">
              <span class="rp-status">Live</span>
              <b>United Kingdom</b>
              <span class="rp-meta">{seatsTotal} seats</span>
            </li>
            <li>
              <span class="rp-status rp-soon">Propose</span>
              <b>France</b>
              <span class="rp-meta">577 circonscriptions</span>
              <a class="rp-link" href="https://github.com/sneldao/civicord/issues">propose ↗</a>
            </li>
            <li>
              <span class="rp-status rp-soon">Propose</span>
              <b>United States</b>
              <span class="rp-meta">435 districts</span>
              <a class="rp-link" href="https://github.com/sneldao/civicord/issues">propose ↗</a>
            </li>
            <li>
              <span class="rp-status rp-soon">Propose</span>
              <b>Your democracy</b>
              <span class="rp-meta">bring a roster + a crawl</span>
              <a class="rp-link" href="/methodology">how it works ↗</a>
            </li>
          </ul>
          <p class="rp-foot">
            Looking for another region?
            <a href="/#regions">See what Civicord needs →</a>
          </p>
        </details>
      </div>

      <p class="crumb region-crumb"><a href="/">Civicord</a> / <b>United Kingdom</b></p>
      <h1 class="region-title vt-uk-title">United Kingdom</h1>
      <p class="lede region-lede">
        Genesis dataset — candidate sites scraped April 2025, audited 17 months later,
        recorded under public names.
      </p>
      <p class="tagline">
        Names on Sepolia today — mainnet next
        (<a href="/methodology#permanence">why testnet first ↗</a>). No account, no wallet.
      </p>
    </header>

    <main id="main" tabindex="-1">
    <section class="browse-cta browse-cta-top" aria-label="Search and browse the ledger">
      <div class="search-hero" role="search">
        <input
          id="q-hero-top"
          type="search"
          placeholder={`Search candidates — try “Farage”, “Leeds Central” or “labour.org.uk”`}
          autocomplete="off"
          aria-label="Search candidates"
          list="hero-constituencies-top"
        />
        <datalist id="hero-constituencies-top">
          {constituenciesForSearch.map((c) => <option value={c.name}></option>)}
        </datalist>
        <button type="button" id="q-go-top">Search ledger →</button>
      </div>
      <div class="browse-actions" style="margin-top:0.55rem">
        <a class="btn-primary" href="/browse">Browse the ledger ↗</a>
        <button type="button" id="random-home-top" class="btn-ghost">Surprise me — random record 🎲</button>
      </div>
    </section>

    <!-- Stats strip owns the corpus numbers — first and only summary. -->
    <section class="stats" aria-label="Audit summary">
      <div class="stat"><b>{candidates.length.toLocaleString("en-GB")}</b><span>Candidates</span></div>
      <div class="stat"><b>{websites.length.toLocaleString("en-GB")}</b><span>Websites</span></div>
      <div class="stat"><b>{audited.length ? pct(live.length, audited.length) : "—"}%</b><span>Still live</span></div>
      <div class="stat"><b>{gone.length.toLocaleString("en-GB")}</b><span>Gone</span></div>
      <div class="stat" title={`Redirect cuts across outcomes — ${liveAndRedirected.toLocaleString("en-GB")} still count as live`}>
        <b>{redirected.length.toLocaleString("en-GB")}</b><span>Redirect elsewhere</span>
      </div>
    </section>

    <p class="decay-line" aria-label="Decay over time">
      <span class="decay-when"><b>April 2025</b></span>
      <span class="decay-arrow" aria-hidden="true">→</span>
      <span class="decay-when"><b>September 2026</b> — <b class="decay-now">{livePctNow}%</b> still live</span>
    </p>

    <section class="cohort-features" aria-label="Explore by outcome">
      <h2>What happened to the sites?</h2>
      <p class="muted">Pick a lane, then drill to the ledger.</p>
      <div class="feature-grid">
        <a class="feature-card f-gone" href="/cohorts/gone">
          <span class="f-label">Gone</span>
          <b class="f-num">{bySlug.gone.sites.toLocaleString("en-GB")}</b>
          <span class="f-meta">{bySlug.gone.share}% · domains that died with the campaign</span>
          <span class="f-cta">The graveyard ↗</span>
        </a>
        <a class="feature-card f-redirected" href="/cohorts/redirected">
          <span class="f-label">Redirected</span>
          <b class="f-num">{bySlug.redirected.sites.toLocaleString("en-GB")}</b>
          <span class="f-meta">{bySlug.redirected.share}% · cross-cutting · {liveAndRedirected.toLocaleString("en-GB")} still live</span>
          <span class="f-cta">Where they went ↗</span>
        </a>
        <a class="feature-card f-live" href="/cohorts/live">
          <span class="f-label">Still live</span>
          <b class="f-num">{bySlug.live.sites.toLocaleString("en-GB")}</b>
          <span class="f-meta">{bySlug.live.share}% · still respond and still mention the candidate</span>
          <span class="f-cta">The survivors ↗</span>
        </a>
      </div>
    </section>

    <HalftoneHexMap />

    <section class="cohorts" aria-label="Survival by party">
      <h2>Which parties' sites survived?</h2>
      <p class="muted">Click a row to filter the ledger.</p>
      <ol class="board" id="party-board">
        {board.map((r) => (
          <li>
            <a href={`/browse?party=${encodeURIComponent(r.party.toLowerCase())}`} data-party-link={r.party.toLowerCase()}>
              <span class="board-party">{r.party}</span>
              <span class="board-bar" aria-hidden="true">
                <b style={`--w:${Math.round((r.sites / maxBoard) * 100)}%;--live:${r.livePct}%`} class={r.livePct >= 60 ? "ok" : r.livePct >= 40 ? "mid" : "low"}></b>
              </span>
              <span class="board-num"><b>{r.livePct}%</b> live · {r.sites.toLocaleString("en-GB")} sites</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <details class="how how-disclosure">
      <summary>How the record is made</summary>
      <ol>
        <li>
          <b>Collect.</b> National roster (Democracy Club) + Campaign Lab’s April 2025 crawl of every candidate site.
        </li>
        <li>
          <b>Audit.</b> Re-request every URL. “Live” means the site answers <em>and</em> still mentions the candidate —
          <a href="/candidates/5693">Dawn Furness</a> now lists for sale;
          <a href="/candidates/111463">Adam Pugh</a> forwards to about.me.
        </li>
        <li>
          <b>Record.</b> Each candidate gets a public name —
          {sampleOnchain?.onchain ? (
            <><code>{(sampleOnchain.onchain as any).ens}</code> (<a href={`/candidates/${sampleOnchain.id}`}>see record ↗</a>)</>
          ) : (
            <code>p5693.civicord.eth</code>
          )}
          — website, status, evidence. Mainnet path in <a href="/methodology#permanence">Methodology</a>.
        </li>
        <li>
          <b>Index.</b> Publish a change log so the record can be queried — by researchers, journalists, and agents.
        </li>
        <li>
          <b>Verify.</b> No account, no wallet, no permission. Every claim links to the public record behind it.
        </li>
      </ol>

      <div class="infra-strip">
        <p class="infra-title">Held by public infrastructure</p>
        <ul class="infra-list">
          <li>
            <span class="infra-k">ENSv2 registry</span>
            <code>0x0895…2aa9</code>
            <a href="https://sepolia.etherscan.io/address/0x08953da0c2ff527a825686a24a12c7bb2ae22aa9" rel="noopener">verify ↗</a>
          </li>
          <li>
            <span class="infra-k">PermissionedResolver</span>
            <code>0x340d…ee67</code>
            <a href="https://sepolia.etherscan.io/address/0x340d18ecb0bbe7bd67b53e836f2f68cf620aee67" rel="noopener">verify ↗</a>
          </li>
          <li>
            <span class="infra-k">Change log (Subgraph)</span>
            <code>QmUcjfa…</code>
            <a href="https://thegraph.com/studio/subgraph/civicord" rel="noopener">verify ↗</a>
          </li>
          <li>
            <span class="infra-k">Agent gateway</span>
            <code>civicord-aieyq</code>
            <a href="https://civicord-aieyq.bazgateway.com/api/summary" rel="noopener">try it ↗</a>
          </li>
        </ul>
      </div>
    </details>
    </main>

    <footer>
      <p>
        Data: Campaign Lab April 2025 · Democracy Club IDs · Audit 2026-09-07 · Wayback (in progress).
        Code <a href="https://github.com/sneldao/civicord">AGPL-3.0</a> ·
        <a href="/methodology">Methodology</a> ·
        <a href="/">← Civicord home</a>
      </p>
    </footer>

    <script define:vars={{ randomIds, constituenciesForSearch }}>
      const HOME_IDS = randomIds;
      const CONS = constituenciesForSearch;
      const consByNameLower = new Map(CONS.map((c) => [c.name.toLowerCase(), c.slug]));
      document.addEventListener("astro:page-load", () => {
        const wireSearch = (inputId, btnId) => {
          const input = document.getElementById(inputId);
          const btn = document.getElementById(btnId);
          const go = () => {
            const v = (input?.value ?? "").trim().slice(0, 120);
            if (!v) { location.href = "/browse"; return; }
            const slug = consByNameLower.get(v.toLowerCase());
            if (slug) { location.href = `/constituencies/${slug}`; return; }
            location.href = `/browse?q=${encodeURIComponent(v)}`;
          };
          if (input && btn) {
            input.addEventListener("keydown", (e) => { if (e.key === "Enter") go(); });
            btn.addEventListener("click", go);
          }
          return input;
        };
        const input = wireSearch("q-hero-top", "q-go-top");

        document.getElementById("random-home-top")?.addEventListener("click", () => {
          const id = HOME_IDS[Math.floor(Math.random() * HOME_IDS.length)];
          location.href = `/candidates/${id}`;
        });

        document.addEventListener("keydown", (e) => {
          const tag = (document.activeElement?.tagName ?? "").toLowerCase();
          const typing = tag === "input" || tag === "textarea" || tag === "select" || (document.activeElement?.isContentEditable);
          if (e.key === "/" && !typing) {
            e.preventDefault();
            input?.focus();
          }
          if (e.key === "Escape" && typing && document.activeElement === input) {
            input.value = "";
            input.blur();
          }
        });

        const bar = document.getElementById("progress-bar");
        if (bar) {
          const onScroll = () => {
            const max = document.documentElement.scrollHeight - innerHeight;
            bar.style.width = `${max > 0 ? Math.min(100, (scrollY / max) * 100) : 0}%`;
          };
          addEventListener("scroll", onScroll, { passive: true });
          onScroll();
        }

        const board = document.getElementById("party-board");
        if (board && "IntersectionObserver" in window) {
          const io = new IntersectionObserver(
            (entries) => {
              for (const e of entries) {
                if (e.isIntersecting) {
                  board.classList.add("is-on");
                  io.disconnect();
                }
              }
            },
            { threshold: 0.25 }
          );
          io.observe(board);
        } else if (board) {
          board.classList.add("is-on");
        }

        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
          for (const el of document.querySelectorAll(".stat b")) {
            const raw = el.textContent?.trim() ?? "";
            if (raw.includes("%")) continue;
            const target = Number(raw.replace(/,/g, ""));
            if (!Number.isFinite(target)) continue;
            const t0 = performance.now();
            const tick = (t) => {
              const p = Math.min(1, (t - t0) / 900);
              const eased = 1 - Math.pow(1 - p, 3);
              el.textContent = Math.round(target * eased).toLocaleString("en-GB");
              if (p < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          }
        }
      });
    </script>
    <PeekSheet />
    <CommandPalette />
    <WebMCP />
  </body>
</html>
