---
import { getCollection } from "astro:content";
import { ClientRouter } from "astro:transitions";
import HalftoneHexMap from "../components/HalftoneHexMap.astro";
import PeekSheet from "../components/PeekSheet.astro";
import CommandPalette from "../components/CommandPalette.astro";
import MobileEssentials from "../components/MobileEssentials.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import WebMCP from "../components/WebMCP.astro";
import "../styles/global.css";
import constituenciesRaw from "../data/constituencies.json";

// Validated at build time by src/content.config.ts
const all = await getCollection("candidates");
const candidates = all.map((e) => e.data).sort((a, b) => a.name.localeCompare(b.name));
const websites = candidates.flatMap((c) => c.websites);
const live = websites.filter((w) => w.audit?.statusClass === "live");
const dead = websites.filter((w) => w.audit?.statusClass === "dns_error");

const VALID_STATUSES = new Set([
  "live", "gone", "redirected",
  "http_error", "dns_error", "connection_error",
  "timeout", "ssl_error", "other_error", "not_audited",
]);
const validParties = new Set(
  candidates.flatMap((c) => c.websites.flatMap((w) => w.parties)).map((p) => p.toLowerCase())
);
const cohortBoot = { statuses: [...VALID_STATUSES], parties: [...validParties] };

const statusLabels: Record<string, string> = {
  live: "Live",
  gone: "Gone",
  redirected: "Redirected ↳",
  http_error: "HTTP error",
  dns_error: "Domain gone",
  connection_error: "Conn. failed",
  timeout: "Timed out",
  ssl_error: "SSL error",
  other_error: "Error",
  not_audited: "Not audited",
};

const changeFilterLabels: Record<string, string> = {
  gone: "Gone (domain dead)",
  repurposed_suspect: "Repurpose suspect",
  redirected: "Redirected",
  still_attested: "Still attested",
  other: "Other / residual",
  unaudited: "Unaudited",
};
const VALID_CHANGES = new Set(Object.keys(changeFilterLabels));

const legendGroups: Array<[string, string, string[]]> = [
  ["g-live", "Live", ["live"]],
  ["g-gone", "Gone", ["dns_error", "connection_error"]],
  ["g-error", "Errors", ["http_error", "timeout", "ssl_error", "other_error"]],
  ["g-unknown", "Not audited", ["not_audited"]],
];
const legendCount = (classes: string[]) =>
  websites.filter((w) => classes.includes(w.audit?.statusClass ?? "not_audited")).length;

const partyCounts = new Map<string, number>();
for (const w of websites) for (const p of w.parties) partyCounts.set(p, (partyCounts.get(p) ?? 0) + 1);
const parties = [...partyCounts.entries()].sort((a, b) => b[1] - a[1]).map(([p]) => p);
const randomIds = candidates.map((c) => c.id);
const goneCount = websites.filter((w) => ["dns_error","connection_error"].includes(w.audit?.statusClass ?? "")).length;
const liveCount = live.length;

// Constituency data for filtering + datalist (static import — Astro/Vite bundles it, no fs at build)
let constituencies: Array<{ slug: string; name: string; gssCode: string; stats: any }> = [];
try {
  const raw: any = (constituenciesRaw as any);
  const arr = Array.isArray(raw) ? raw : Array.isArray(raw?.default) ? raw.default : [];
  if (arr.length) constituencies = arr as any;
} catch {}
const constituencySlugs = new Set(constituencies.map((c) => c.slug));
const constituencyBySlug = new Map(constituencies.map((c) => [c.slug, c]));
const constituencyNamesForDatalist = constituencies.map((c) => c.name);

// Helper for row constituency slugs — must match build-map.mjs slugify
function slugify(name: string): string {
  let s = name.normalize("NFD").replace(/[\u0300-\u036f]/g, "");
  s = s.replace(/&/g, " and ");
  s = s.toLowerCase();
  s = s.replace(/[^a-z0-9]+/g, "-");
  s = s.replace(/^-+|-+$/g, "").replace(/--+/g, "-");
  return s;
}
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content={`Browse all ${candidates.length.toLocaleString("en-GB")} UK candidate records — filter by party, status, constituency and search. ${live.length} sites still live, ${dead.length} domains gone.`}
    />
    <meta property="og:title" content="Browse the ledger — Civicord" />
    <meta
      property="og:description"
      content={`All ${candidates.length.toLocaleString("en-GB")} candidates, filterable by party, constituency and outcome. What survived and what didn't.`}
    />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Browse — Civicord</title>
    <ClientRouter />
  </head>
  <body class="reveal-root">
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="progress" aria-hidden="true"><b id="progress-bar"></b></div>

    <p class="crumb"><a href="/">Civicord</a> · <a href="/uk">United Kingdom</a> / <b>Browse</b></p>

    <header class="masthead">
      <h1 class="wordmark">Browse<span class="dot">.</span></h1>
      <p class="lede">All {candidates.length.toLocaleString("en-GB")} candidates — filter, search, then open the record. Pick a hex to see a seat.</p>
      <p class="tagline">
        Every row is a candidate website from Campaign Lab's April 2025 scrape, re-checked September 2026.
        <a href="/methodology">Methodology ↗</a> · <a href="/uk">← Back to UK overview</a>
      </p>
    </header>

    <main id="main" tabindex="-1">
    <HalftoneHexMap />

    <div id="constituency-banner" class="constituency-banner" hidden>
      <span>Showing <b id="constituency-banner-name"></b> — <span id="constituency-banner-stats"></span></span>
      <a id="constituency-banner-link" href="#">View seat page ↗</a>
      <button type="button" id="clear-constituency">Clear</button>
    </div>

    <div class="filterbar" role="search" aria-label="Filter candidates">
      <input id="q" type="search" placeholder="Filter by candidate, party, constituency, website… — try “farrage” or “Ynys Môn”" autocomplete="off" aria-label="Search" list="browse-constituencies" />
      <datalist id="browse-constituencies">
        {constituencyNamesForDatalist.map((n) => <option value={n}></option>)}
      </datalist>
      <label class="visually-hidden" for="status">Filter by status</label>
      <select id="status" aria-label="Filter by status">
        <option value="all">All statuses</option>
        {Object.entries(statusLabels).map(([value, label]) => <option value={value}>{label}</option>)}
      </select>
      <label class="visually-hidden" for="change">Filter by change</label>
      <select id="change" aria-label="Filter by what changed">
        <option value="all">All changes</option>
        {Object.entries(changeFilterLabels).map(([value, label]) => (
          <option value={value}>{label}</option>
        ))}
      </select>
      <label class="visually-hidden" for="party">Filter by party</label>
      <select id="party" aria-label="Filter by party">
        <option value="all">All parties</option>
        {parties.map((p) => <option value={p.toLowerCase()}>{p}</option>)}
      </select>
      <span id="count" class="count" role="status" aria-live="polite"></span>
    </div>

    <div class="legend" role="group" aria-label="Filter by status group">
      {legendGroups.map(([dot, label, classes]) => (
        <button type="button" class="legend-item" data-classes={classes.join(",")} aria-pressed="false">
          <span class={`dot ${dot}`} aria-hidden="true"></span>
          {label} <b>{legendCount(classes).toLocaleString("en-GB")}</b>
        </button>
      ))}
      <span class="legend-hint">click to filter</span>
    </div>

    <div class="browse-toolbar">
      <button type="button" id="random-browse" class="btn-ghost btn-sm">Surprise me — random record 🎲</button>
      <button type="button" id="copy-link" class="btn-ghost btn-sm">Copy filtered link</button>
      <span id="copy-toast" class="copy-toast" hidden role="status" aria-live="polite"></span>
      <span class="toolbar-hint muted">Press <kbd>/</kbd> to search, <kbd>⌘K</kbd> to jump anywhere, <kbd>Esc</kbd> to clear · Click a hex to peek at the seat</span>
    </div>

    <div class="table-wrap">
      <table aria-label="Candidate ledger">
        <thead>
          <tr><th>Candidate</th><th>Party</th><th>Election</th><th>Website</th><th>Status</th></tr>
        </thead>
        <tbody id="ledger-body">
          {candidates.flatMap((c) =>
            c.websites.map((w) => {
              const st = w.audit?.statusClass ?? "not_audited";
              const change = w.changeSignal ?? "unaudited";
              const constSlugs = w.posts.map((p) => slugify(p)).join("|");
              const postsStr = w.posts.join(" ");
              return (
                <tr
                  class={`row-st-${st}`}
                  data-status={st}
                  data-change={change}
                  data-redirected={w.audit?.redirected ? "1" : "0"}
                  data-party={w.parties.map((p) => p.toLowerCase()).join("|")}
                  data-constituency={constSlugs}
                  data-haystack={`${c.name} ${w.parties.join(" ")} ${postsStr} ${w.elections[0] ?? ""} ${w.url}`.toLowerCase()}
                >
                  <td class="who">
                    <a class="who-name" href={`/candidates/${c.id}`}>{c.name}</a>
                    {c.onchain && <span class="onchain-chip" title={`${c.onchain.ens} — permanent public record`}>On-chain ✓</span>}
                  </td>
                  <td class="muted" data-label="Party">{w.parties.join(", ")}</td>
                  <td class="muted" data-label="Election">{w.elections[0]}</td>
                  <td class="url" data-label="Website">
                    <a class="url" href={w.url} rel="noopener noreferrer" title={w.url}>
                      {w.url.replace(/^https?:\/\//, "").replace(/\/$/, "")}
                    </a>
                    {w.posts[0] && <div style="font-size:0.72em;color:var(--muted);margin-top:0.15rem">{w.posts[0]}</div>}
                  </td>
                  <td data-label="Status">
                    <span class={`badge ${st}`}>{statusLabels[st]}</span>
                    {w.audit?.redirected && <span class="redir" title={w.audit.finalUrl ?? ""}> ↳</span>}
                  </td>
                </tr>
              );
            })
          )}
        </tbody>
      </table>
    </div>

    <div id="noresults" class="noresults" hidden>
      <p><b>No matches</b><span id="noresults-query"></span> — try a different spelling or filter.</p>
      <p id="noresults-suggest" class="muted" hidden></p>
      <div class="noresults-actions">
        <button type="button" id="clear" class="btn-primary btn-sm">Clear filters</button>
        <a href="/browse?status=gone" class="btn-ghost btn-sm">Browse Gone ({goneCount.toLocaleString("en-GB")})</a>
        <a href="/browse?status=live" class="btn-ghost btn-sm">Browse Live ({liveCount.toLocaleString("en-GB")})</a>
        <a href="/browse" class="btn-ghost btn-sm">Show all 2,375</a>
      </div>
    </div>

    <nav id="pagination" class="pagination" aria-label="Pagination"></nav>
    </main>

    <footer>
      <p>
        <a href="/uk">← UK overview</a> · <a href="/">Home</a> · <a href="/methodology">Methodology</a> · Map: Automatic Knowledge v5 (OGL) · Data: Campaign Lab April 2025 · Democracy Club IDs · Audit 2026-09-07
        · <a href="https://github.com/sneldao/civicord">github.com/sneldao/civicord</a>
      </p>
    </footer>

    <script define:vars={{ statuses: cohortBoot.statuses, parties: cohortBoot.parties, changeSignals: [...VALID_CHANGES], randomIds, goneCount, liveCount, constituencySlugs: [...constituencySlugs], constituencyList: constituencies.map((c) => ({ slug: c.slug, name: c.name, stats: c.stats })) }}>
      window.__COHORT_STATUSES = statuses;
      window.__COHORT_PARTIES = parties;
      window.__COHORT_CHANGES = changeSignals;
      window.__COHORT_CONSTITUENCIES = constituencySlugs;
      window.__CONSTITUENCY_LIST = constituencyList;
      const BROWSE_IDS = randomIds;
      document.addEventListener("astro:page-load", () => {
        const PAGE_SIZE = 50;

        const fuzzyMatch = (hay, needle) => {
          if (hay.includes(needle)) return true;
          if (needle.length > 40) return false;
          let j = 0;
          for (let i = 0; i < hay.length && j < needle.length; i++) {
            if (hay[i] === needle[j]) j++;
          }
          return j === needle.length;
        };

        const escapeRegExp = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
        const escapeHtml = (s) => s.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");

        const q = document.getElementById("q");
        const status = document.getElementById("status");
        const change = document.getElementById("change");
        const party = document.getElementById("party");
        const count = document.getElementById("count");
        const noresults = document.getElementById("noresults");
        const noresultsQuery = document.getElementById("noresults-query");
        const noresultsSuggest = document.getElementById("noresults-suggest");
        const clear = document.getElementById("clear");
        const legend = [...document.querySelectorAll(".legend-item")];
        const rows = [...document.querySelectorAll("#ledger-body tr")];
        const pagination = document.getElementById("pagination");
        const copyBtn = document.getElementById("copy-link");
        const copyToast = document.getElementById("copy-toast");
        const randomBtn = document.getElementById("random-browse");
        const banner = document.getElementById("constituency-banner");
        const bannerName = document.getElementById("constituency-banner-name");
        const bannerStats = document.getElementById("constituency-banner-stats");
        const bannerLink = document.getElementById("constituency-banner-link");
        const clearConstituencyBtn = document.getElementById("clear-constituency");
        const VALID_CHANGES = new Set(window.__COHORT_CHANGES ?? []);

        // store originals for highlight restore
        for (const tr of rows) {
          const nameEl = tr.querySelector(".who-name");
          if (nameEl) nameEl.dataset.orig = nameEl.innerHTML;
          const urlEl = tr.querySelector("a.url");
          if (urlEl) urlEl.dataset.orig = urlEl.innerHTML;
        }

        let legendClasses = null;
        let currentPage = 1;
        let activeConstituency = null;

        const constituencyBySlug = new Map((window.__CONSTITUENCY_LIST ?? []).map((c) => [c.slug, c]));

        const getParams = () => new URLSearchParams(location.search);

        const syncUrl = () => {
          const out = new URLSearchParams();
          if (q.value.trim()) out.set("q", q.value.trim().slice(0, 120));
          if (status.value !== "all") out.set("status", status.value);
          if (change && change.value !== "all") out.set("change", change.value);
          if ((party?.value ?? "all") !== "all") out.set("party", party.value);
          if (activeConstituency) out.set("constituency", activeConstituency);
          if (currentPage > 1) out.set("page", String(currentPage));
          const next = out.toString();
          history.replaceState(null, "", next ? `${location.pathname}?${next}` : location.pathname);
        };

        const updateBanner = () => {
          if (!banner || !bannerName || !bannerStats || !bannerLink) return;
          if (!activeConstituency) {
            banner.hidden = true;
            return;
          }
          const c = constituencyBySlug.get(activeConstituency);
          const name = c?.name ?? activeConstituency.replace(/-/g, " ");
          bannerName.textContent = name;
          if (c?.stats) {
            const s = c.stats;
            bannerStats.textContent = s.sites ? `${s.live} of ${s.sites} live (${s.livePct}%)` : "no scraped site";
          } else {
            bannerStats.textContent = "";
          }
          bannerLink.href = `/constituencies/${activeConstituency}`;
          banner.hidden = false;
        };

        const renderPagination = (total, page, totalPages) => {
          if (!pagination) return;
          pagination.innerHTML = "";
          if (total === 0 || totalPages <= 1) {
            pagination.hidden = total === 0;
            if (totalPages <= 1 && total > 0) {
              const info = document.createElement("span");
              info.className = "page-info";
              info.textContent = `${total.toLocaleString("en-GB")} entries`;
              pagination.appendChild(info);
              pagination.hidden = false;
            }
            return;
          }
          pagination.hidden = false;

          const mkBtn = (label, p, disabled, active) => {
            const b = document.createElement("button");
            b.type = "button";
            b.textContent = label;
            b.disabled = !!disabled;
            if (active) b.setAttribute("aria-current", "page");
            b.addEventListener("click", () => {
              currentPage = p;
              syncUrl();
              apply();
              window.scrollTo({ top: 0, behavior: "smooth" });
            });
            return b;
          };

          pagination.appendChild(mkBtn("← Prev", Math.max(1, page - 1), page === 1, false));

          // windowed page numbers: first, last, and 2 around current
          const pages = [];
          for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || Math.abs(i - page) <= 2) pages.push(i);
            else if (pages[pages.length - 1] !== "…") pages.push("…");
          }
          for (const p of pages) {
            if (p === "…") {
              const s = document.createElement("span");
              s.textContent = "…";
              s.className = "page-ellipsis";
              pagination.appendChild(s);
            } else {
              const b = mkBtn(String(p), p, false, p === page);
              if (p === page) b.className = "is-active";
              pagination.appendChild(b);
            }
          }

          pagination.appendChild(mkBtn("Next →", Math.min(totalPages, page + 1), page === totalPages, false));

          const info = document.createElement("span");
          info.className = "page-info";
          info.textContent = `page ${page} of ${totalPages} · ${total.toLocaleString("en-GB")} matches`;
          pagination.appendChild(info);
        };

        const highlight = (el, needle) => {
          const orig = el.dataset.orig ?? el.textContent;
          if (!needle || !el.textContent.toLowerCase().includes(needle)) {
            el.innerHTML = orig;
            return;
          }
          const re = new RegExp(`(${escapeRegExp(needle)})`, "ig");
          // work from textContent to avoid double-escaping, but preserve orig escaping
          const text = el.textContent;
          el.innerHTML = escapeHtml(text).replace(re, "<mark>$1</mark>");
        };

        const apply = () => {
          const needle = q.value.trim().toLowerCase();
          const want = status.value;
          const wantChange = change?.value ?? "all";
          const wantParty = party?.value ?? "all";

          // virtual status "redirected" filters on the redirected flag
          const wantRedirected = want === "redirected";
          const wantGone = want === "gone";
          const filtered = [];
          let filteredLive = 0;
          for (const tr of rows) {
            const isRedirected = tr.dataset.redirected === "1";
            const isGone = tr.dataset.status === "dns_error" || tr.dataset.status === "connection_error";
            const statusMatches = want === "all"
              ? true
              : wantRedirected ? isRedirected
              : wantGone ? isGone
              : tr.dataset.status === want;
            const changeMatches = wantChange === "all" || tr.dataset.change === wantChange;
            const constituencyMatches = !activeConstituency || (tr.dataset.constituency ?? "").split("|").includes(activeConstituency);
            const matches =
              (wantParty === "all" || (tr.dataset.party ?? "").split("|").includes(wantParty)) &&
              (!needle || fuzzyMatch(tr.dataset.haystack, needle)) &&
              statusMatches &&
              changeMatches &&
              (!legendClasses || legendClasses.includes(tr.dataset.status)) &&
              constituencyMatches;
            tr.dataset.matched = matches ? "1" : "0";
            if (matches) {
              filtered.push(tr);
              if (tr.dataset.status === "live") filteredLive++;
            }
          }

          const total = filtered.length;
          const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
          if (currentPage > totalPages) currentPage = totalPages;
          if (currentPage < 1) currentPage = 1;

          // hide all, then show slice — with highlight on visible slice
          for (const tr of rows) {
            tr.hidden = true;
            // reset highlights for hidden rows immediately
            const nameEl = tr.querySelector(".who-name");
            const urlEl = tr.querySelector("a.url");
            if (nameEl) nameEl.innerHTML = nameEl.dataset.orig ?? nameEl.textContent;
            if (urlEl) urlEl.innerHTML = urlEl.dataset.orig ?? urlEl.textContent;
          }
          if (total > 0) {
            const start = (currentPage - 1) * PAGE_SIZE;
            const slice = filtered.slice(start, start + PAGE_SIZE);
            const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
            for (const [i, tr] of slice.entries()) {
              tr.hidden = false;
              tr.classList.remove("is-settling");
              if (!reduceMotion) {
                tr.style.setProperty("--row-i", String(Math.min(i, 24)));
                void tr.offsetWidth;
                tr.classList.add("is-settling");
              }
              if (needle) {
                const hay = tr.dataset.haystack ?? "";
                if (hay.includes(needle)) {
                  const nameEl = tr.querySelector(".who-name");
                  const urlEl = tr.querySelector("a.url");
                  if (nameEl) highlight(nameEl, needle);
                  if (urlEl && urlEl.textContent.toLowerCase().includes(needle)) highlight(urlEl, needle);
                  // also highlight party cell if it contains needle — secondary
                  const partyCell = tr.querySelector('td[data-label="Party"]');
                  if (partyCell && partyCell.textContent.toLowerCase().includes(needle)) {
                    if (!partyCell.dataset.orig) partyCell.dataset.orig = partyCell.innerHTML;
                    highlight(partyCell, needle);
                  } else if (partyCell && partyCell.dataset.orig) {
                    partyCell.innerHTML = partyCell.dataset.orig;
                  }
                }
              } else {
                const partyCell = tr.querySelector('td[data-label="Party"]');
                if (partyCell && partyCell.dataset.orig) partyCell.innerHTML = partyCell.dataset.orig;
              }
            }
          }

          const isDefault = !needle && want === "all" && wantParty === "all" && !legendClasses && !activeConstituency;
          if (total === 0) {
            count.textContent = "no matches";
            if (noresultsQuery) noresultsQuery.textContent = needle ? ` for “${q.value.trim().slice(0,40)}”` : "";
            // suggest closest party if needle looks like a party typo
            if (noresultsSuggest && needle.length >= 3) {
              const candidates = window.__COHORT_PARTIES ?? [];
              let best = null; let bestScore = 0;
              for (const p of candidates) {
                if (p.includes(needle) || needle.includes(p.slice(0, 5))) { best = p; break; }
                // quick subsequence score
                let j=0; for (let i=0;i<p.length&&j<needle.length;i++) if (p[i]===needle[j]) j++;
                const score = j/needle.length;
                if (score > 0.8 && score > bestScore) { best = p; bestScore = score; }
              }
              if (best) {
                noresultsSuggest.hidden = false;
                noresultsSuggest.innerHTML = `Did you mean <button type="button" class="link-inline" data-suggest-party="${best}">${best}</button>?`;
                noresultsSuggest.querySelector("[data-suggest-party]")?.addEventListener("click", (e) => {
                  const v = e.currentTarget.dataset.suggestParty;
                  if (party && window.__COHORT_PARTIES.includes(v)) { party.value = v; q.value = ""; legendClasses=null; legend.forEach((b)=>b.setAttribute("aria-pressed","false")); currentPage=1; syncUrl(); apply(); }
                });
              } else {
                noresultsSuggest.hidden = true;
              }
            }
          } else if (isDefault) {
            const pctLive = Math.round((filteredLive / total) * 100);
            count.textContent = `${total.toLocaleString("en-GB")} entries · ${pctLive}% live · page ${currentPage} of ${totalPages}`;
          } else {
            const pctLive = Math.round((filteredLive / total) * 100);
            const label = activeConstituency ? constituencyBySlug.get(activeConstituency)?.name ?? activeConstituency : "";
            const prefix = activeConstituency ? `${label} · ` : "";
            count.textContent = `${prefix}${total.toLocaleString("en-GB")} shown · ${pctLive}% live · page ${currentPage} of ${totalPages}`;
          }
          noresults.hidden = total !== 0;
          renderPagination(total, currentPage, totalPages);
          updateBanner();
        };

        q.addEventListener("input", () => { currentPage = 1; syncUrl(); apply(); });
        status.addEventListener("change", () => { currentPage = 1; syncUrl(); apply(); });
        change?.addEventListener("change", () => { currentPage = 1; syncUrl(); apply(); });
        party?.addEventListener("change", () => { currentPage = 1; syncUrl(); apply(); });
        legend.forEach((btn) =>
          btn.addEventListener("click", () => {
            const classes = btn.dataset.classes.split(",");
            const active = btn.getAttribute("aria-pressed") === "true";
            legend.forEach((b) => b.setAttribute("aria-pressed", "false"));
            if (active) {
              legendClasses = null;
            } else {
              btn.setAttribute("aria-pressed", "true");
              legendClasses = classes;
              status.value = "all";
            }
            currentPage = 1;
            syncUrl();
            apply();
          })
        );
        clear.addEventListener("click", () => {
          q.value = "";
          status.value = "all";
          if (change) change.value = "all";
          if (party) party.value = "all";
          legendClasses = null;
          legend.forEach((b) => b.setAttribute("aria-pressed", "false"));
          activeConstituency = null;
          currentPage = 1;
          syncUrl();
          apply();
          q.focus();
        });
        clearConstituencyBtn?.addEventListener("click", () => {
          activeConstituency = null;
          currentPage = 1;
          syncUrl();
          apply();
        });

        // Copy filtered link
        let toastTimer = null;
        const showToast = (msg) => {
          if (!copyToast) return;
          copyToast.textContent = msg;
          copyToast.hidden = false;
          clearTimeout(toastTimer);
          toastTimer = setTimeout(() => { copyToast.hidden = true; }, 2200);
        };
        copyBtn?.addEventListener("click", async () => {
          syncUrl();
          const url = location.href;
          try {
            await navigator.clipboard.writeText(url);
            showToast("Copied ✓ — share this view");
            copyBtn.textContent = "Copied ✓";
            setTimeout(() => { copyBtn.textContent = "Copy filtered link"; }, 1800);
          } catch {
            // fallback: select + prompt
            prompt("Copy this link:", url);
          }
        });

        // Surprise me
        randomBtn?.addEventListener("click", () => {
          const id = BROWSE_IDS[Math.floor(Math.random() * BROWSE_IDS.length)];
          location.href = `/candidates/${id}`;
        });

        // Keyboard: / focuses search, Esc clears
        document.addEventListener("keydown", (e) => {
          const tag = (document.activeElement?.tagName ?? "").toLowerCase();
          const typing = tag === "input" || tag === "textarea" || tag === "select" || (document.activeElement?.isContentEditable);
          if (e.key === "/" && !typing) {
            e.preventDefault();
            q.focus();
          }
          if (e.key === "Escape" && typing && document.activeElement === q) {
            if (q.value) {
              q.value = "";
              currentPage = 1;
              syncUrl();
              apply();
            } else if (activeConstituency) {
              activeConstituency = null;
              currentPage = 1;
              syncUrl();
              apply();
            } else {
              q.blur();
            }
          }
        });

        // Handle hex map clicks via custom event
        window.addEventListener("civicord:constituency", (e) => {
          const slug = e.detail?.slug;
          if (!slug) return;
          if ((window.__COHORT_CONSTITUENCIES ?? []).includes(slug)) {
            activeConstituency = slug;
            currentPage = 1;
            syncUrl();
            apply();
          }
        });

        // boot from URL
        const params = getParams();
        const bootStatuses = window.__COHORT_STATUSES;
        const bootParties = window.__COHORT_PARTIES;
        const bootConstituencies = window.__COHORT_CONSTITUENCIES ?? [];
        const qp = (params.get("party") ?? "").toLowerCase();
        const qs = params.get("status") ?? "";
        const qchange = params.get("change") ?? "";
        const qq = params.get("q") ?? "";
        const qc = (params.get("constituency") ?? "").toLowerCase();
        const qpage = parseInt(params.get("page") ?? "1", 10);
        if (party && qp && bootParties.includes(qp)) party.value = qp;
        if (qs && bootStatuses.includes(qs)) status.value = qs;
        if (change && qchange && VALID_CHANGES.has(qchange)) change.value = qchange;
        if (qc && bootConstituencies.includes(qc)) activeConstituency = qc;
        if (qq) q.value = qq.slice(0, 120);
        if (Number.isFinite(qpage) && qpage > 1) currentPage = Math.min(qpage, 500);

        // virtual statuses that map to filtered views (cohort deeplinks)
        if (qs === "gone" || qs === "redirected") {
          const hasOption = [...status.options].some((o) => o.value === qs);
          if (hasOption) status.value = qs;
          else status.value = qs;
          if (qs === "gone") {
            legend.forEach((b) => {
              if (b.dataset.classes === "dns_error,connection_error") b.setAttribute("aria-pressed", "true");
            });
            legendClasses = null;
          }
        }

        apply();

        // scroll progress
        const bar = document.getElementById("progress-bar");
        if (bar) {
          const onScroll = () => {
            const max = document.documentElement.scrollHeight - innerHeight;
            bar.style.width = `${max > 0 ? Math.min(100, (scrollY / max) * 100) : 0}%`;
          };
          addEventListener("scroll", onScroll, { passive: true });
          onScroll();
        }
      });
    </script>
    <PeekSheet />
    <CommandPalette />
    <MobileEssentials />
    <ScrollReveal />
    <WebMCP />
  </body>
</html>
