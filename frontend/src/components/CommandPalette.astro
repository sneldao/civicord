---
// Command palette — ⌘K / Ctrl-K.
//
// Progressive disclosure for power users: the index of 3,025 records stays
// hidden until someone asks for it, and the 48 KB payload is fetched lazily on
// first open, so visitors who never press ⌘K pay nothing.
//
// This is the journalist's primitive: for a 2,375-record dataset, "jump
// straight there" beats scrolling 48 pages of ledger.
---

<dialog id="palette" class="palette" aria-labelledby="palette-label">
  <div class="palette-inner">
    <label class="visually-hidden" for="palette-input" id="palette-label">
      Jump to a candidate, jurisdiction, party or cohort
    </label>
    <input
      id="palette-input"
      class="palette-input"
      type="search"
      placeholder="Jump to a candidate, seat, party or cohort…"
      autocomplete="off"
      spellcheck="false"
      role="combobox"
      aria-expanded="true"
      aria-controls="palette-results"
      aria-autocomplete="list"
    />
    <ul id="palette-results" class="palette-results" role="listbox" aria-label="Results"></ul>
    <p class="palette-foot">
      <kbd>↑</kbd><kbd>↓</kbd> move · <kbd>↵</kbd> open · <kbd>Esc</kbd> close
      <span class="palette-count muted" id="palette-count"></span>
    </p>
  </div>
</dialog>

<button type="button" id="palette-trigger" class="palette-trigger" aria-label="Open quick jump (Command K)">
  <span aria-hidden="true">⌘</span><span aria-hidden="true">K</span>
</button>

<script>
  const esc = (s: unknown) =>
    String(s ?? "").replace(/[&<>"']/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c] as string)
    );

  type Entry = { kind: string; label: string; sub: string; href: string };

  let indexLoaded = false;
  let loading: Promise<void> | null = null;
  let entries: Entry[] = [];
  let results: Entry[] = [];
  let cursor = 0;
  let bound = false;

  const ACTIONS: Entry[] = [
    { kind: "Go", label: "Browse the full ledger", sub: "2,375 records", href: "/browse" },
    { kind: "Cohort", label: "Gone — domains that died", sub: "the graveyard", href: "/cohorts/gone" },
    { kind: "Cohort", label: "Redirected — where they went", sub: "repurposed sites", href: "/cohorts/redirected" },
    { kind: "Cohort", label: "Still live — the survivors", sub: "still mention the candidate", href: "/cohorts/live" },
    { kind: "Read", label: "Methodology — how we checked", sub: "sources and definitions", href: "/methodology" },
  ];

  // Subsequence match with word-start and adjacency bonuses — the same idea as
  // the ledger's "farrage → Farage" matcher, kept small enough to ship inline.
  function score(hayRaw: string, needle: string): number {
    const hay = hayRaw.toLowerCase();
    if (!needle) return 1;
    if (hay.startsWith(needle)) return 100 - hay.length * 0.01;
    const at = hay.indexOf(needle);
    if (at > -1) return 60 - at * 0.5 - hay.length * 0.01;
    let h = 0;
    let n = 0;
    let s = 0;
    let last = -2;
    while (h < hay.length && n < needle.length) {
      if (hay[h] === needle[n]) {
        if (last === h - 1) s += 4;
        const prev = hay[h - 1];
        if (h === 0 || prev === " " || prev === "-" || prev === "," || prev === "&") s += 6;
        last = h;
        n++;
      }
      h++;
    }
    return n === needle.length ? s - (h - needle.length) * 0.05 : -1;
  }

  async function loadIndex() {
    if (indexLoaded) return;
    if (loading) return loading;
    loading = (async () => {
      try {
        const res = await fetch("/search-index.json", { headers: { accept: "application/json" } });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const d = await res.json();
        const parties: string[] = d.parties ?? [];
        const out: Entry[] = ACTIONS.slice();

        for (const [slug, name, region, livePct, sites] of d.seats ?? []) {
          out.push({
            kind: "Jurisdiction",
            label: name,
            sub: sites
              ? `${region ? region + " · " : ""}${livePct}% of ${sites} sites live`
              : `${region ? region + " · " : ""}no scraped site`,
            href: `/constituencies/${slug}`,
          });
        }
        for (const [id, name, pid, seat] of d.people ?? []) {
          out.push({
            kind: "Candidate",
            label: name,
            sub: [parties[pid], seat ? seat.replace(/-/g, " ") : ""].filter(Boolean).join(" · "),
            href: `/candidates/${id}`,
          });
        }
        for (const name of parties) {
          if (!name) continue;
          out.push({
            kind: "Party",
            label: name,
            sub: "filter the ledger by party",
            href: `/browse?party=${encodeURIComponent(name.toLowerCase())}`,
          });
        }

        entries = out;
        indexLoaded = true;
      } catch {
        entries = ACTIONS.slice();
        indexLoaded = true;
      } finally {
        loading = null;
      }
    })();
    return loading;
  }

  function paint() {
    const list = document.getElementById("palette-results");
    const count = document.getElementById("palette-count");
    if (!list) return;
    if (!results.length) {
      list.innerHTML = `<li class="palette-empty muted">No matches — try a surname, a seat, or a party.</li>`;
      if (count) count.textContent = "";
      return;
    }
    list.innerHTML = results
      .map(
        (r, i) => `<li
          id="palette-opt-${i}"
          role="option"
          aria-selected="${i === cursor}"
          class="palette-row${i === cursor ? " is-cursor" : ""}"
          data-href="${esc(r.href)}"
        ><span class="pr-kind">${esc(r.kind)}</span><span class="pr-label">${esc(r.label)}</span><span class="pr-sub muted">${esc(r.sub)}</span></li>`
      )
      .join("");
    if (count) count.textContent = `${results.length} shown`;
    const input = document.getElementById("palette-input");
    if (input) input.setAttribute("aria-activedescendant", `palette-opt-${cursor}`);
  }

  function search() {
    const input = document.getElementById("palette-input") as HTMLInputElement | null;
    const q = (input?.value ?? "").trim().toLowerCase();
    if (!q) {
      // Default view: the actions, plus a sample of jurisdictions.
      results = entries.filter((e) => e.kind === "Go" || e.kind === "Cohort" || e.kind === "Read").slice(0, 6);
      if (results.length < 6) results = results.concat(entries.filter((e) => e.kind === "Jurisdiction").slice(0, 6));
      cursor = 0;
      paint();
      return;
    }
    const scored: Array<{ e: Entry; s: number }> = [];
    for (const e of entries) {
      const a = score(e.label, q);
      const b = score(e.sub, q) * 0.35;
      const best = Math.max(a, b);
      if (best > 0) scored.push({ e, s: best + (e.kind === "Jurisdiction" ? 3 : 0) });
    }
    scored.sort((x, y) => y.s - x.s);
    results = scored.slice(0, 12).map((x) => x.e);
    cursor = 0;
    paint();
  }

  function move(delta: number) {
    if (!results.length) return;
    cursor = (cursor + delta + results.length) % results.length;
    paint();
    document.querySelector(".palette-row.is-cursor")?.scrollIntoView({ block: "nearest" });
  }

  function go(href?: string) {
    const target = href ?? results[cursor]?.href;
    const dlg = document.getElementById("palette") as HTMLDialogElement | null;
    const input = document.getElementById("palette-input") as HTMLInputElement | null;
    if (input) input.value = "";
    dlg?.close();
    if (target) location.href = target;
  }

  async function openPalette() {
    const dlg = document.getElementById("palette") as HTMLDialogElement | null;
    if (!dlg) return;
    if (!dlg.open) {
      try {
        dlg.showModal();
      } catch {
        dlg.setAttribute("open", "");
      }
    }
    const input = document.getElementById("palette-input") as HTMLInputElement | null;
    input?.focus();
    if (!indexLoaded) {
      const list = document.getElementById("palette-results");
      if (list) list.innerHTML = `<li class="palette-empty muted">Loading 3,025 records…</li>`;
    }
    await loadIndex();
    search();
  }

  document.addEventListener("astro:page-load", () => {
    const dlg = document.getElementById("palette") as HTMLDialogElement | null;
    const input = document.getElementById("palette-input") as HTMLInputElement | null;
    if (!dlg || !input) return;

    input.addEventListener("input", search);
    document.getElementById("palette-trigger")?.addEventListener("click", () => openPalette());
    dlg.addEventListener("click", (e) => {
      if (e.target === dlg) dlg.close();
    });
    document.getElementById("palette-results")?.addEventListener("click", (e) => {
      const row = (e.target as HTMLElement)?.closest?.("[data-href]") as HTMLElement | null;
      if (row?.dataset.href) go(row.dataset.href);
    });

    input.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") {
        e.preventDefault();
        move(1);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        move(-1);
      } else if (e.key === "Enter") {
        e.preventDefault();
        go();
      } else if (e.key === "Escape" && input.value) {
        // First Esc clears the query, second closes the dialog.
        e.preventDefault();
        input.value = "";
        search();
      }
    });

    if (!bound) {
      bound = true;
      document.addEventListener("keydown", (e) => {
        const mod = e.metaKey || e.ctrlKey;
        if (mod && (e.key === "k" || e.key === "K")) {
          e.preventDefault();
          const d = document.getElementById("palette") as HTMLDialogElement | null;
          if (d?.open) d.close();
          else openPalette();
        }
      });
    }
  });
</script>
