---
import type { ClaimPair, UnmatchedAddition } from "../lib/change-feed";

interface Props {
  pairs: ClaimPair[];
  additions: UnmatchedAddition[];
  listGap?: string | null;
}

const { pairs, additions, listGap = null } = Astro.props;
---

{listGap && <p class="pair-gap">{listGap}</p>}

{pairs.map((pair) => (
  <article class="pair-card">
    <div class="pair">
      <div class="pair-side">
        <h3 class="change-kicker">Before · {pair.beforeLabel}</h3>
        <p class="claim-text">{pair.beforeText}</p>
        {pair.topics.length > 0 && (
          <p class="pair-topics">
            {pair.topics.map((topic) => <span class="sig-chip">{topic.replaceAll("_", " ")}</span>)}
          </p>
        )}
      </div>
      <div class="pair-side pair-side--after">
        <h3 class="change-kicker">After · {pair.afterLabel}</h3>
        <p>Not found on the homepage fetch.</p>
        <p class="muted pair-url"><a href={pair.url} rel="noopener noreferrer">{pair.url}</a></p>
      </div>
    </div>
    <p class="pair-gap">Gap: no replacement sentence is matched. Scope: {pair.scopeNote}.</p>
    <p class="pair-actions">
      <button type="button" class="btn-ghost btn-sm" data-claim-citation={pair.citation}>Copy this line</button>
      <span class="pair-copy-status" role="status"></span>
    </p>
  </article>
))}

{additions.length > 0 && (
  <>
    <h3 class="claims-sub">New on the later homepage, not matched to a removed sentence</h3>
    <ul class="facts claims-list">
      {additions.map((item) => (
        <li>
          <span class="claim-text">{item.text}</span>
          {item.topics.map((topic) => <span class="sig-chip">{topic.replaceAll("_", " ")}</span>)}
          <span class="pair-gap"> {item.gap} {item.afterLabel} · {item.url}</span>
        </li>
      ))}
    </ul>
  </>
)}
