---
// Peek sheet — inspect a jurisdiction in place, without losing your scroll.
//
// Progressive disclosure: the map used to navigate away on every click. Now a
// click opens this sheet, which offers the two real exits (open the full
// record / filter the ledger) only once you've seen enough.
//
// It fetches the *same* static JSON that the Bazantic gateway meters, so the
// site's own UI is an API client — the public API isn't a side door.
//
// No-JS note: the sheet is an enhancement. Every jurisdiction stays reachable
// without it via /browse, the ledger and the sitemap.
---

<dialog id="peek-sheet" class="peek" aria-labelledby="peek-title">
  <div class="peek-inner">
    <header class="peek-head">
      <div>
        <p class="peek-kicker">Jurisdiction</p>
        <h2 class="peek-title" id="peek-title">Reading…</h2>
        <p class="peek-meta" id="peek-meta"></p>
      </div>
      <button type="button" class="peek-close" id="peek-close" aria-label="Close">×</button>
    </header>

    <div class="peek-body" id="peek-body">
      <p class="muted">Reading the public record…</p>
    </div>

    <footer class="peek-foot">
      <a class="btn-primary btn-sm" id="peek-open" href="#">Open full record ↗</a>
      <button type="button" class="btn-ghost btn-sm" id="peek-filter" hidden>Filter the ledger</button>
      <a class="btn-ghost btn-sm" id="peek-api" href="#" rel="noopener">Its public API ↗</a>
    </footer>
    <p class="peek-note muted">Reading <code id="peek-path">/api/…</code> — the same static JSON an agent pays for.</p>
  </div>
</dialog>

<script>
  import { openDialog, closeDialog, bindDialogChrome } from "../lib/dialog-motion";

  (window as any).__CIVICORD_PEEK__ = true;

  const esc = (s: unknown) =>
    String(s ?? "").replace(/[&<>"']/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c] as string)
    );

  const reduced = () =>
    typeof matchMedia === "function" && matchMedia("(prefers-reduced-motion: reduce)").matches;

  const dotsFor = (pct: number) => (pct >= 66 ? 1 : pct >= 40 ? 2 : 3);

  let currentSlug: string | null = null;
  let bound = false;

  function render(c: any) {
    const s = c.stats ?? {};
    const title = document.getElementById("peek-title");
    const meta = document.getElementById("peek-meta");
    const body = document.getElementById("peek-body");
    const open = document.getElementById("peek-open") as HTMLAnchorElement | null;
    const api = document.getElementById("peek-api") as HTMLAnchorElement | null;
    const path = document.getElementById("peek-path");
    if (!title || !meta || !body) return;

    title.textContent = c.name ?? c.slug ?? "Jurisdiction";
    const bits = [c.gssCode, c.region || c.country, c.electorate ? `${Number(c.electorate).toLocaleString("en-GB")} electorate` : ""].filter(Boolean);
    if (meta) meta.textContent = bits.join(" · ");

    if (open) open.href = `/constituencies/${c.slug}`;
    if (api) api.href = `/api/constituencies/${c.slug}.json`;
    if (path) path.textContent = `/api/constituencies/${c.slug}.json`;

    const noSites = !s.sites;
    const share = noSites
      ? "No candidate site was recorded here in the April 2025 scrape — 17 seats are like this."
      : `<b>${s.live} of ${s.sites}</b> sites still live (${s.livePct}%) · ${s.gone} gone · ${s.redirected} redirected`;

    const cands: any[] = Array.isArray(c.candidates) ? c.candidates : [];
    const dotCount = noSites ? 0 : dotsFor(s.livePct ?? 0);

    body.innerHTML = `
      <p class="peek-share">${share}</p>
      ${noSites ? "" : `<div class="peek-dots" aria-hidden="true">${Array.from({ length: dotCount })
        .map(() => `<i class="peek-dot"></i>`)
        .join("")}<span class="peek-dots-label">${dotCount} ${dotCount === 1 ? "dot" : "dots"} = ${dotCount === 1 ? "mostly holding" : dotCount === 2 ? "half gone" : "mostly gone"}</span></div>`}
      ${
        cands.length
          ? `<ul class="peek-cands">${cands
              .slice(0, 8)
              .map(
                (cd) => `<li>
                  <span class="badge ${esc(cd.statusClass)}">${esc(cd.statusClass)}</span>
                  <a href="/candidates/${esc(cd.id)}">${esc(cd.name)}</a>
                  <span class="muted">${esc(cd.party)}</span>
                  ${cd.onchain ? `<code title="${esc(cd.onchain.ens)}">${esc(cd.onchain.ens)}</code>` : ""}
                </li>`
              )
              .join("")}${cands.length > 8 ? `<li class="muted">+ ${cands.length - 8} more in the full record</li>` : ""}</ul>`
          : ""
      }
    `;
  }

  /** Continuity morph: ink stamp flies from the hex to the peek sheet. */
  function morphFromHex(hexEl: HTMLElement | null, dlg: HTMLDialogElement) {
    if (!hexEl || reduced()) return;
    const from = hexEl.getBoundingClientRect();
    const to = dlg.getBoundingClientRect();
    if (!from.width || !to.width) return;

    const ghost = document.createElement("div");
    ghost.className = "peek-morph";
    ghost.setAttribute("aria-hidden", "true");
    const size = Math.max(from.width, from.height) * 0.85;
    const x0 = from.left + from.width / 2 - size / 2;
    const y0 = from.top + from.height / 2 - size / 2;
    const x1 = to.left + 28;
    const y1 = to.top + 36;
    ghost.style.width = `${size}px`;
    ghost.style.height = `${size}px`;
    ghost.style.left = `${x0}px`;
    ghost.style.top = `${y0}px`;
    document.body.appendChild(ghost);

    // Origin for the sheet itself — opens as if expanding from the hex.
    const dx = from.left + from.width / 2 - (to.left + to.width * 0.15);
    const dy = from.top + from.height / 2 - (to.top + 72);
    dlg.style.setProperty("--peek-from-x", `${dx}px`);
    dlg.style.setProperty("--peek-from-y", `${dy}px`);

    requestAnimationFrame(() => {
      ghost.style.transform = `translate(${x1 - x0}px, ${y1 - y0}px) scale(${Math.max(18, to.width * 0.08) / size})`;
      ghost.style.opacity = "0";
    });
    window.setTimeout(() => ghost.remove(), 420);
  }

  async function open(slug: string, name?: string, hexEl?: HTMLElement | null) {
    const dlg = document.getElementById("peek-sheet") as HTMLDialogElement | null;
    const title = document.getElementById("peek-title");
    const body = document.getElementById("peek-body");
    const filter = document.getElementById("peek-filter") as HTMLButtonElement | null;
    if (!dlg) return;

    currentSlug = slug;
    if (title) title.textContent = name || "Reading…";
    if (body) body.innerHTML = `<p class="muted">Reading the public record…</p>`;
    if (filter) filter.hidden = !location.pathname.startsWith("/browse");

    openDialog(dlg);
    morphFromHex(hexEl ?? null, dlg);

    try {
      const res = await fetch(`/api/constituencies/${encodeURIComponent(slug)}.json`, {
        headers: { accept: "application/json" },
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      render(await res.json());
    } catch (err) {
      if (body) {
        body.innerHTML = `<p class="muted">Couldn't load this record live (<b>${esc(
          (err as Error).message
        )}</b>). The full record still works:</p>
        <p><a class="btn-ghost btn-sm" href="/constituencies/${esc(slug)}">Open ${esc(name || slug)} ↗</a></p>`;
      }
    }
  }

  document.addEventListener("astro:page-load", () => {
    const dlg = document.getElementById("peek-sheet") as HTMLDialogElement | null;
    if (!dlg) return;

    const notifyClosed = () => {
      dlg.style.removeProperty("--peek-from-x");
      dlg.style.removeProperty("--peek-from-y");
      window.dispatchEvent(new CustomEvent("civicord:peek-close"));
    };

    bindDialogChrome(dlg, { onClosed: notifyClosed });

    document.getElementById("peek-close")?.addEventListener("click", () => {
      void closeDialog(dlg);
    });

    dlg.addEventListener("click", (e) => {
      if (e.target === dlg) void closeDialog(dlg);
    });

    document.getElementById("peek-filter")?.addEventListener("click", () => {
      if (!currentSlug) return;
      window.dispatchEvent(new CustomEvent("civicord:constituency", { detail: { slug: currentSlug } }));
      void closeDialog(dlg).then(() => {
        document.querySelector(".table-wrap")?.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });

    if (!bound) {
      bound = true;
      window.addEventListener("civicord:peek", (e: Event) => {
        const detail = (e as CustomEvent).detail || {};
        if (detail.slug) open(detail.slug, detail.name, detail.hexEl ?? null);
      });
    }
  });
</script>
