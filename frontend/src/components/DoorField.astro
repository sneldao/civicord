---
/**
 * Door visual — pointillist field encoding the UK live-share.
 * Not a basemap: equal dots, colour = still live vs gone/broken.
 * Stable seeded jitter so the composition doesn't reshuffle every build.
 */
interface Props {
  livePct: number;
  candidates: number;
}
const { livePct, candidates } = Astro.props;

const W = 360;
const H = 220;
const N = 160;
const liveN = Math.round((livePct / 100) * N);

// Mulberry32 — deterministic layout from candidate count (stable across builds).
function mulberry32(a: number) {
  return () => {
    let t = (a += 0x6d2b79f5);
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = mulberry32(candidates || 2375);

type Dot = { cx: number; cy: number; r: number; live: boolean; i: number };
const dots: Dot[] = [];
for (let i = 0; i < N; i++) {
  // Soft oval bias — reads as a place without claiming a real coastline.
  const u = rand();
  const v = rand();
  const ang = u * Math.PI * 2;
  const rad = Math.sqrt(v) * 0.92;
  const cx = W * 0.5 + Math.cos(ang) * rad * W * 0.42 + (rand() - 0.5) * 10;
  const cy = H * 0.52 + Math.sin(ang) * rad * H * 0.38 + (rand() - 0.5) * 8;
  dots.push({
    cx,
    cy,
    r: 2.1 + rand() * 1.6,
    live: i < liveN,
    i,
  });
}
---

<figure class="door-field" aria-hidden="true">
  <svg class="door-field-svg" viewBox={`0 0 ${W} ${H}`} role="presentation">
    <rect width={W} height={H} fill="transparent"></rect>
    {dots.map((d) => (
      <circle
        class={d.live ? "df-live" : "df-gone"}
        cx={d.cx}
        cy={d.cy}
        r={d.r}
        style={`--di:${d.i}`}
      ></circle>
    ))}
  </svg>
  <figcaption class="door-field-cap">
    <span class="df-key"><i class="df-swatch live"></i> {livePct}% responding</span>
    <span class="df-key"><i class="df-swatch gone"></i> {100 - livePct}% unavailable or erroring</span>
  </figcaption>
</figure>
